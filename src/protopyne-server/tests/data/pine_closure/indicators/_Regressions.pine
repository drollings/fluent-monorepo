// Moving Average Settings for Trend Consensus
const string sMAHeader = "Moving Averages for Trend Consensus"
typePrimaryMA = input.enum(libMAs.Smoothings.ALMA, title="Primary ", group=sMAHeader, inline="Primary")
lenPrimaryMA = input.int(7, "", minval=2, group=sMAHeader, inline="Primary")
typeSignalMA = input.enum(libMAs.Smoothings.EMA, title="Signal   ", group=sMAHeader, inline="Signal")
lenSignalMA = input.int(8, "", minval=2, group=sMAHeader, inline="Signal")
typeMeanMA = input.enum(libMAs.Smoothings.EMA, title="Mean     ", group=sMAHeader, inline="Mean")
lenMeanMA = input.int(21, "", minval=2, group=sMAHeader, inline="Mean")

// Voss Predictive Filter Settings
const string sVossHeader = "Voss Predictive Filter"
const string sVossTooltip = "Spectral analysis filter for cycle detection and trend prediction"
