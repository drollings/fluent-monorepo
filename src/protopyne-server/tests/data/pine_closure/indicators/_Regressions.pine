colorNone = color.rgb(0,0,0,100)

// Enhanced logistic regression input indices (8 sophisticated confidence-based inputs)
const int IDX_CONFIDENCE_FAST = 0
const int IDX_CONFIDENCE_MEDIUM = 1
const int IDX_CONFIDENCE_SLOW = 2
const int IDX_ATR_DISTANCE = 3
const int IDX_VOLUME_ANALYSIS = 4
const int IDX_VOLATILITY_CONTEXT = 5
const int IDX_VOSS_CYCLE = 6
const int IDX_CHANNEL_ANALYSIS = 7
const int IDX_MAX = 8

///////////////////////////////////////////////////////////////////////////////
// LIBRARY CANDIDATE FUNCTIONS
///////////////////////////////////////////////////////////////////////////////

// @function Library candidate: Calculate linear regression channel slope
// @param data Price data series
// @param length Period for regression calculation
// @returns float Channel slope value
getChannelSlope(float data, int length) =>
    ta.linreg(data, length, 0) - ta.linreg(data, length, 1)

// @function Library candidate: Calculate linear regression channel with deviation
// @param data Price data series
// @param length Period for regression calculation
// @param deviation_multiplier Standard deviation multiplier for channel bands
// @returns [float, float, float, float] [slope, middle_line, upper_band, lower_band]
calculateLinearChannel(float data, int length, float deviation_multiplier) =>
    // Calculate regression using Pine's built-in function
    current_regression = ta.linreg(data, length, 0)
    slope = getChannelSlope(data, length)

    // Calculate standard deviation using historical data approach
    sum_data = 0.0
    sum_squared_diff = 0.0

    // Calculate mean
    for i = 0 to length - 1
        sum_data := sum_data + data[i]
    mean_data = sum_data / length

    // Calculate regression line values and deviations
    for i = 0 to length - 1
        // Calculate expected regression value for this point
        regression_value = current_regression - slope * i
        // Calculate squared difference from actual data
        sum_squared_diff := sum_squared_diff + math.pow(data[i] - regression_value, 2)

    // Standard deviation
    dev = math.sqrt(sum_squared_diff / length)

    upper_band = current_regression + dev * deviation_multiplier
    lower_band = current_regression - dev * deviation_multiplier

    [slope, current_regression, upper_band, lower_band]

// @function Library candidate: Calculates ATR distance confidence score
// @param _atr_distance (float) Distance from mean in ATR units
// @returns float ATR distance confidence score (-100 to +100)
// @description Measures mean reversion pressure based on distance from EMA21.
calcAtrDistanceConfidence(float _atr_distance, float entry, float exit) =>
    if na(_atr_distance)
        0.0
    else
        // Base distance score
        distance_score = libMAs.tanh(_atr_distance / 3) * 70

        // Extension penalty (reduces confidence when extremely extended)
        extension_penalty = libMAs.tanh((math.abs(_atr_distance) - exit) / entry) * 30
        extension_direction = -math.sign(_atr_distance)

        // Combined ATR distance confidence
        raw_score = distance_score + (extension_penalty * extension_direction)
        libMAs.tanh(raw_score / 80) * 100

// @function Library candidate: Calculates volume momentum and consistency confidence score
// @param _o (float) Opening price
// @param _c (float) Closing price
// @param vol_delta (float) Volume delta (buying vs selling pressure)
// @param _vol_ratio (float) Current volume ratio relative to average
// @returns float Volume confidence score (-100 to +100)
calcVolumeConfidence(float _o, float _c, float vol_delta, float _vol_ratio) =>
    if na(_o) or na(_c) or na(vol_delta) or na(_vol_ratio)
        0.0
    else
        // Price direction
        price_direction = math.sign(_c - _o)

        // Volume momentum (above/below average)
        vol_momentum_raw = _vol_ratio > 1.0 ? (_vol_ratio - 1.0) * 60 : (_vol_ratio - 1.0) * 80
        vol_momentum = libMAs.tanh(vol_momentum_raw / 50) * 50

        // Volume delta alignment (buying vs selling pressure)
        vol_delta_normalized = libMAs.tanh((vol_delta - 1.0) * 2) * 40

        // Volume consistency (strength of the volume signal)
        vol_consistency = libMAs.tanh(math.abs(vol_delta - 1.0) * 1.5) * 30

        // Direction alignment bonus/penalty
        alignment_factor = price_direction * math.sign(vol_delta_normalized)
        alignment_bonus = alignment_factor * vol_consistency * 0.5

        // Combined volume confidence
        raw_score = vol_momentum + vol_delta_normalized + alignment_bonus
        libMAs.tanh(raw_score / 80) * 100

// @function Library candidate: Calculates MA health trend alignment confidence score
// @param _health_score (float) Pre-calculated trend health score from MA alignment
// @param _health_score_sma10 (float) SMA10 of health score for momentum analysis
// @returns float MA health confidence score (-100 to +100)
calcMaHealthConfidence(float _health_score, float _health_score_sma10) =>
    if na(_health_score) or na(_health_score_sma10)
        0.0
    else
        // Base health score (current trend quality)
        base_health = libMAs.tanh(_health_score / 80) * 60

        // Health momentum (position relative to recent average)
        health_momentum = _health_score - _health_score_sma10
        momentum_score = libMAs.tanh(health_momentum / 30) * 40

        // Combined health confidence with momentum component
        raw_score = base_health + momentum_score
        libMAs.tanh(raw_score / 80) * 100

// @function Library candidate: Calculates volatility context confidence score
// @param trend_dir (float) Current trend direction (-1, 0, 1)
// @param _atr (float) Current ATR value
// @param _atr_sma (float) ATR simple moving average for context
// @returns float Volatility confidence score (-100 to +100)
calcVolatilityConfidence(float trend_dir, float _atr, float _atr_sma) =>
    if na(trend_dir) or na(_atr) or na(_atr_sma) or _atr_sma <= 0
        0.0
    else
        // Volatility ratio (current vs average)
        volatility_ratio = _atr / _atr_sma

        // Volatility expansion/contraction
        vol_expansion = libMAs.tanh((volatility_ratio - 1.0) * 5) * 60

        // Volatility momentum (rate of change)
        atr_momentum = (_atr - _atr[5]) / _atr[5]
        vol_momentum = libMAs.tanh(atr_momentum * 10) * 40

        // Context: expansion good for new trends, contraction good for trend continuation
        trend_strength = math.abs(trend_dir)
        expansion_context = trend_strength > 0.5 ? vol_expansion * 0.7 : vol_expansion

        // Combined volatility confidence
        raw_score = expansion_context + vol_momentum
        libMAs.tanh(raw_score / 80) * 100

// @function Library candidate: Calculates Voss cycle momentum confidence score
// @param _voss (float) Voss Predictive Filter current value
// @param _voss_filter (float) Voss filter reference line
// @returns float Voss confidence score (-100 to +100)
calcVossConfidence(float _voss, float _voss_filter) =>
    if na(_voss) or na(_voss_filter)
        0.0
    else
        // Voss position relative to filter
        voss_position = _voss - _voss_filter
        position_score = libMAs.tanh(voss_position * 10) * 50

        // Voss acceleration (second derivative)
        voss_velocity = _voss - _voss[1]
        voss_acceleration = voss_velocity - (_voss[1] - _voss[2])
        acceleration_score = libMAs.tanh(voss_acceleration * 500) * 50

        // Combined Voss confidence
        raw_score = position_score + acceleration_score
        libMAs.tanh(raw_score / 80) * 100

// @function Library candidate: Detects bullish divergence between price and an oscillator
// @param price_series Price data to analyze
// @param oscillator_series Oscillator data (volume ratio, RSI, etc.)
// @param lookback Period to look for divergence
// @returns float Divergence strength (0-1)
calcBullishDivergence(series float price_series, series float oscillator_series, simple int lookback) =>
    if na(price_series) or na(oscillator_series) or lookback <= 0
        0.0
    else
        // Find recent lows in the lookback period
        price_low = ta.lowest(price_series, lookback)
        osc_low = ta.lowest(oscillator_series, lookback)

        // Check if current price is at or near the low
        is_price_low = price_series <= price_low * 1.02  // Within 2% of low

        // Check if oscillator has improved significantly from its low
        osc_improvement = oscillator_series > osc_low * 1.1  // 10% improvement

        // Calculate divergence strength
        if is_price_low and osc_improvement and osc_low != 0
            // Normalize the improvement to 0-1 scale
            improvement_ratio = (oscillator_series - osc_low) / math.abs(osc_low)
            math.min(improvement_ratio, 1.0)
        else
            0.0

// @function Library candidate: Detects bearish divergence between price and an oscillator
// @param price_series Price data to analyze
// @param oscillator_series Oscillator data (volume ratio, RSI, etc.)
// @param lookback Period to look for divergence
// @returns float Divergence strength (0-1)
calcBearishDivergence(series float price_series, series float oscillator_series, simple int lookback) =>
    if na(price_series) or na(oscillator_series) or lookback <= 0
        0.0
    else
        // Find recent highs in the lookback period
        price_high = ta.highest(price_series, lookback)
        osc_high = ta.highest(oscillator_series, lookback)

        // Check if current price is at or near the high
        is_price_high = price_series >= price_high * 0.98  // Within 2% of high

        // Check if oscillator has weakened significantly from its high
        osc_weakness = oscillator_series < osc_high * 0.9  // 10% deterioration

        // Calculate divergence strength
        if is_price_high and osc_weakness and osc_high != 0
            // Normalize the deterioration to 0-1 scale
            deterioration_ratio = (osc_high - oscillator_series) / math.abs(osc_high)
            math.min(deterioration_ratio, 1.0)
        else
            0.0

// @function Library candidate: Calculate specialized channel analysis confidence score
// @param slope Current channel slope
// @param price Current price
// @param upper Upper channel band
// @param lower Lower channel band
// @param atr Average True Range for normalization
// @returns float Channel confidence score (-100 to +100)
calculateChannelConfidence(float slope, float price, float upper, float lower, float atr) =>
    // Position within channel (-100 = bottom, +100 = top)
    channel_range = upper - lower
    if channel_range <= 0
        0.0
    else
        position = (price - lower) / channel_range * 200 - 100

        // Slope strength (normalized by ATR)
        slope_strength = math.max(-50, math.min(50, slope / atr * 10000))

        // Combine position and slope with better logic
        if slope > 0 and position > 20  // Uptrend, price in upper half
            math.min(100, slope_strength + position * 0.5)
        else if slope < 0 and position < -20  // Downtrend, price in lower half
            math.max(-100, slope_strength + position * 0.5)
        else
            // Neutral or conflicting signals
            slope_strength * 0.5

// @function Convert confidence scores to logistic regression inputs
// @param confidence_scores Array of confidence scores (-100 to +100)
// @returns array<float> Array of logistic inputs (-1, 0, +1)
convertConfidenceToLogisticInputs(array<float> confidence_scores) =>
    logistic_inputs = array.new<float>(IDX_MAX, 0.0)

    for i = 0 to IDX_MAX - 1
        confidence = array.get(confidence_scores, i)
        logistic_value = confidence <= -40 ? -1.0 : (confidence >= 40 ? 1.0 : 0.0)
        array.set(logistic_inputs, i, logistic_value)

    logistic_inputs

// @function Calculate final logistic regression probability
// @param inputs Array of logistic inputs (-1, 0, +1)
// @param weights Array of user-defined weights
// @param steepness Logistic function steepness
// @returns [float, float] [probability, raw_weighted_score]
calculateLogisticRegression(array<float> inputs, array<float> weights, float steepness) =>
    if array.size(inputs) != array.size(weights)
        runtime.error("Inputs and weights arrays must be same size")
        [0.5, 0.0]

    weighted_sum = 0.0
    weight_sum = 0.0

    for i = 0 to array.size(inputs) - 1
        input_val = array.get(inputs, i)
        weight = array.get(weights, i)
        weighted_sum += input_val * weight
        weight_sum += weight

    // Calculate weighted average
    raw_score = weight_sum > 0 ? weighted_sum / weight_sum : 0.0

    // Apply logistic function: 1 / (1 + exp(-x))
    logistic_result = 1.0 / (1.0 + math.exp(-raw_score * steepness))

    [logistic_result, raw_score]

// @function Inflecting candle detection (from original)
candlesInflectUp(float c) =>
    c[1] < c and c[2] > c[1] and ta.lowest(c, 10) == c[1] ? true : false

candlesInflectDown(float c) =>
    c[1] > c and c[2] < c[1] and ta.highest(c, 10) == c[1] ? true : false

// @function Normalized close for display (from original)
getNormalizedClose(src) =>
    basis = libMAs.factorySmoothing(src, libMAs.Smoothings.SMA, 10)
    zscore = (src - basis) / ta.stdev(src, 50)
    zscore

