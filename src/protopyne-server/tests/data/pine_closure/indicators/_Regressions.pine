reversal_threshold = input.float(60, 'Reversal Threshold', step=10, minval=20, maxval=200, group=sMTFHeader, inline='mtf2')

// Enhanced Meta-Analysis Weights (8 sophisticated confidence-based inputs)
const string sCoefficientHeader = "ENHANCED CONFIDENCE WEIGHTS 𝛃 (0 deactivates)"
float weightConfidenceFast = input.float(2.0, "𝛃 Fast Confidence    ", step=0.5, minval=0, group=sCoefficientHeader, inline="Conf1")
float weightConfidenceMedium = input.float(3.0, "𝛃 Medium Confidence  ", step=0.5, minval=0, group=sCoefficientHeader, inline="Conf2")
float weightConfidenceSlow = input.float(4.0, "𝛃 Slow Confidence    ", step=0.5, minval=0, group=sCoefficientHeader, inline="Conf3")
float weightATRDistance = input.float(2.5, "𝛃 ATR Distance       ", step=0.5, minval=0, group=sCoefficientHeader, inline="Analysis1")
float weightVolumeAnalysis = input.float(3.0, "𝛃 Volume Analysis    ", step=0.5, minval=0, group=sCoefficientHeader, inline="Analysis2")
float weightVolatilityContext = input.float(2.0, "𝛃 Volatility Context ", step=0.5, minval=0, group=sCoefficientHeader, inline="Analysis3")
float weightVossCycle = input.float(2.5, "𝛃 Voss Cycle         ", step=0.5, minval=0, group=sCoefficientHeader, inline="Analysis4")
float weightChannelAnalysis = input.float(3.0, "𝛃 Channel Analysis   ", step=0.5, minval=0, group=sCoefficientHeader, inline="Analysis5")

// ATR Distance Settings
const string sATRHeader = "ATR Distance Analysis"
