vossPredict = input.int(3, "Predict", minval=1, maxval=10, group=sVossHeader, inline="Voss")
vossBand = input.float(0.25, "Band", minval=0.05, maxval=0.5, step=0.05, group=sVossHeader, inline="Voss")

// Volume Analysis Settings
const string sVolumeHeader = "Volume Analysis"
volumeLookback = input.int(20, "Volume Average Period", minval=5, maxval=50, group=sVolumeHeader, inline="Vol")
volumeThreshold = input.float(1.5, "Volume Spike Threshold", minval=1.0, maxval=5.0, step=0.1, group=sVolumeHeader, inline="Vol")

// Display Options
const string sDebugHeader = "Display Options"
bool bLabelLogisticRegression = input.bool(false, '👁️ Labels', group=sDebugHeader, inline="AB")
bool bShowInflectingCandles = input.bool(true, title="👁️ Inflecting Candles", group=sDebugHeader, inline="FB")
colorInflectingBullish = input.color(color.rgb(0, 120, 240, 20), "", group=sDebugHeader, inline="FB")
colorInflectingBearish = input.color(color.rgb(240, 80, 52, 20), "", group=sDebugHeader, inline="FB")

///////////////////////////////////////////////////////////////////////////////
// VARIABLE INITIALIZATION
///////////////////////////////////////////////////////////////////////////////

// Throttling setup (following Trend Consensus pattern)
throttling_interval = math.max(2000, math.round(math.log(10 + timeframe.in_seconds(timeframe.period) * 300)))
var int throttling_time = 0

// Multi-timeframe Trend Consensus objects
var libTrendConsensus.TrendConsensus tc_fast = na
var libTrendConsensus.TrendConsensus tc_medium = na
var libTrendConsensus.TrendConsensus tc_slow = na

// Initialize TrendConsensus objects
if na(tc_fast)
    tc_fast := libTrendConsensus.TrendConsensus.new()
    tc_fast.update_interval := math.max(1000, math.round(math.log(5 + libMAs.getTimeframeSeconds(timeframe_fast))*2000))
if na(tc_medium)
    tc_medium := libTrendConsensus.TrendConsensus.new()
    tc_medium.update_interval := math.max(2000, math.round(math.log(5 + libMAs.getTimeframeSeconds(timeframe_medium))*4000))
if na(tc_slow)
    tc_slow := libTrendConsensus.TrendConsensus.new()
    tc_slow.update_interval := math.max(5000, math.round(math.log(5 + libMAs.getTimeframeSeconds(timeframe_slow))*8000))

// Enhanced meta-analysis weights and state
var array<float> meta_weights = array.from(weightConfidenceFast, weightConfidenceMedium, weightConfidenceSlow,
                                          weightATRDistance, weightVolumeAnalysis, weightVolatilityContext,
                                          weightVossCycle, weightChannelAnalysis)
var array<string> meta_names = array.from("FAST_CONF", "MED_CONF", "SLOW_CONF",
                                         "ATR_DIST", "VOLUME", "VOLATILITY", "VOSS", "CHANNEL")

// State variables for meta-analysis
var float logistic_regression = 0.5
var float raw_meta_consensus = 0.0
var array<float> current_confidences = array.new<float>(IDX_MAX, 0.0)
var array<float> current_inputs = array.new<float>(IDX_MAX, 0.0)

// Channel analysis with RingBufferPivot
var libPivots.RingBufferPivot pivots = na
if na(pivots)
    pivots := libPivots.RingBufferPivot.new()
    pivots.init(20)

// Quick calculations (updated every bar)
_ma_primary = libMAs.factorySmoothing(sourceMA, typePrimaryMA, lenPrimaryMA)
_ma_signal = libMAs.factorySmoothing(sourceMA, typeSignalMA, lenSignalMA)
_ma_mean = libMAs.factorySmoothing(sourceMA, typeMeanMA, lenMeanMA)
_atr = ta.atr(21)

// Volume analysis
_volume_safe = na(volume) or volume <= 0 ? 1.0 : volume
_vol_sma = ta.sma(_volume_safe, volumeLookback)
_vol_ratio = _volume_safe / _vol_sma

///////////////////////////////////////////////////////////////////////////////
// THROTTLED EXPENSIVE CALCULATIONS
///////////////////////////////////////////////////////////////////////////////

float health_fast = 0.0
float health_med = 0.0
float health_slow = 0.0

if time > (throttling_time + throttling_interval)

    // Update meta-analysis weights from user inputs
    array.set(meta_weights, IDX_CONFIDENCE_FAST, weightConfidenceFast)
    array.set(meta_weights, IDX_CONFIDENCE_MEDIUM, weightConfidenceMedium)
    array.set(meta_weights, IDX_CONFIDENCE_SLOW, weightConfidenceSlow)
    array.set(meta_weights, IDX_ATR_DISTANCE, weightATRDistance)
    array.set(meta_weights, IDX_VOLUME_ANALYSIS, weightVolumeAnalysis)
    array.set(meta_weights, IDX_VOLATILITY_CONTEXT, weightVolatilityContext)
    array.set(meta_weights, IDX_VOSS_CYCLE, weightVossCycle)
    array.set(meta_weights, IDX_CHANNEL_ANALYSIS, weightChannelAnalysis)

    // 1. Multi-timeframe Trend Confidence Analysis

    // Fast timeframe confidence
    if timeframe_fast != libMAs.Timeframes.C
        tf_str = libMAs.getTimeframeAbbrev(timeframe_fast)
        [data_fast, ma_fast, ma_signal_fast, ma_mean_fast, atr_fast] = request.security(syminfo.tickerid, tf_str,
           [close, libMAs.factorySmoothing(close, typePrimaryMA, lenPrimaryMA),
           libMAs.factorySmoothing(close, typeSignalMA, lenSignalMA),
           libMAs.factorySmoothing(close, typeMeanMA, lenMeanMA), ta.atr(21)])
        health_fast = libMAs.getHealthMAs(atr_fast, ma_fast, ma_signal_fast, ma_mean_fast, 1.0)
        [dir_fast, conf_fast] = libTrendConsensus.updateTrendHealth(tc_fast, data_fast, health_fast, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_FAST, conf_fast)
    else
        health_fast = libMAs.getHealthMAs(_atr, _ma_primary, _ma_signal, _ma_mean, 1.0)
        [dir_fast, conf_fast] = libTrendConsensus.updateTrendHealth(tc_fast, close, health_fast, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_FAST, conf_fast)

    // Medium timeframe confidence
    if timeframe_medium != libMAs.Timeframes.C
        tf_str = libMAs.getTimeframeAbbrev(timeframe_medium)
        [data_med, ma_fast_med, ma_signal_med, ma_mean_med, atr_med] = request.security(syminfo.tickerid, tf_str,
           [close, libMAs.factorySmoothing(close, typePrimaryMA, lenPrimaryMA),
           libMAs.factorySmoothing(close, typeSignalMA, lenSignalMA),
           libMAs.factorySmoothing(close, typeMeanMA, lenMeanMA), ta.atr(21)])
        health_med = libMAs.getHealthMAs(atr_med, ma_fast_med, ma_signal_med, ma_mean_med, 1.0)
        [dir_med, conf_med] = libTrendConsensus.updateTrendHealth(tc_medium, data_med, health_med, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_MEDIUM, conf_med)
    else
        health_med = libMAs.getHealthMAs(_atr, _ma_primary, _ma_signal, _ma_mean, 1.0)
        [dir_med, conf_med] = libTrendConsensus.updateTrendHealth(tc_medium, close, health_med, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_MEDIUM, conf_med)

    // Slow timeframe confidence
    if timeframe_slow != libMAs.Timeframes.C
        tf_str = libMAs.getTimeframeAbbrev(timeframe_slow)
        [data_slow, ma_fast_slow, ma_signal_slow, ma_mean_slow, atr_slow] = request.security(syminfo.tickerid, tf_str,
           [close, libMAs.factorySmoothing(close, typePrimaryMA, lenPrimaryMA),
           libMAs.factorySmoothing(close, typeSignalMA, lenSignalMA),
           libMAs.factorySmoothing(close, typeMeanMA, lenMeanMA), ta.atr(21)])
        health_slow = libMAs.getHealthMAs(atr_slow, ma_fast_slow, ma_signal_slow, ma_mean_slow, 1.0)
        [dir_slow, conf_slow] = libTrendConsensus.updateTrendHealth(tc_slow, data_slow, health_slow, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_SLOW, conf_slow)
    else
        health_slow = libMAs.getHealthMAs(_atr, _ma_primary, _ma_signal, _ma_mean, 1.0)
        [dir_slow, conf_slow] = libTrendConsensus.updateTrendHealth(tc_slow, close, health_slow, reversal_threshold)
        array.set(current_confidences, IDX_CONFIDENCE_SLOW, conf_slow)

    // 2. Enhanced Specialized Analysis Using Proven Confidence Functions

    // ATR Distance Analysis
    atr_distance = (close - _ma_mean) / _atr
    atr_confidence = calcAtrDistanceConfidence(atr_distance, atrEntry, atrExit)
    array.set(current_confidences, IDX_ATR_DISTANCE, atr_confidence)

    // Volume Analysis (enhanced with momentum and consistency)
    [vol_up, vol_down] = libMAs.calculateDeltaVolume(open, high, low, close, _volume_safe)
    vol_delta = vol_up / math.max(vol_down, 1.0)  // Ratio form for calcVolumeConfidence
    volume_confidence = calcVolumeConfidence(open, close, vol_delta, _vol_ratio)
    array.set(current_confidences, IDX_VOLUME_ANALYSIS, volume_confidence)

    // Volatility Context Analysis
    trend_direction = health_slow > 20 ? 1 : (health_slow < -20 ? -1 : 0)  // Current trend direction
    _atr_sma = ta.sma(_atr, 20)
    volatility_confidence = calcVolatilityConfidence(trend_direction, _atr, _atr_sma)
    array.set(current_confidences, IDX_VOLATILITY_CONTEXT, volatility_confidence)

    // Voss Cycle Analysis (enhanced with acceleration)
    [voss_pred, voss_filter] = libMAs.getVossPredictiveFilter(close, vossPeriod, vossPredict, vossBand)
    voss_confidence = calcVossConfidence(voss_pred, voss_filter)
    array.set(current_confidences, IDX_VOSS_CYCLE, voss_confidence)

    // Channel Analysis (enhanced position + slope analysis)
    [channel_slope, channel_middle, channel_upper, channel_lower] = calculateLinearChannel(sourceMA, lenChannel, lenDeviation)
    channel_confidence = calculateChannelConfidence(channel_slope, close, channel_upper, channel_lower, _atr)
    array.set(current_confidences, IDX_CHANNEL_ANALYSIS, channel_confidence)

    // 3. Meta-Analysis: Convert to logistic inputs and calculate final regression
    current_inputs := convertConfidenceToLogisticInputs(current_confidences)
    [logistic_regression, raw_meta_consensus] = calculateLogisticRegression(current_inputs, meta_weights, consensusSteepness)

    // Update pivots with volume delta for advanced analysis
    pivots.add_pivot(close > close[1], close, bar_index, vol_up, vol_down)

    throttling_time := time

///////////////////////////////////////////////////////////////////////////////
// CHANNEL VISUALIZATION
///////////////////////////////////////////////////////////////////////////////

// Calculate linear regression channel for display
[channel_slope_display, channel_middle_display, channel_upper_display, channel_lower_display] = calculateLinearChannel(sourceMA, lenChannel, lenDeviation)

// Channel break detection (from original)
outofchannel = (channel_slope_display > 0 and close < channel_lower_display) ? 0 :
               (channel_slope_display < 0 and close > channel_upper_display) ? 2 : -1

// Channel visualization
var line upperLine = na
var line middleLine = na
var line lowerLine = na
var label slopeLabel = na

if barstate.islast and bExtendChannel
    line.delete(upperLine)
    line.delete(middleLine)
    line.delete(lowerLine)
    label.delete(slopeLabel)

    start_bar = bar_index - lenChannel + 1
    channel_color = channel_slope_display > 0 ? colorUpChannel : colorDownChannel

    // Calculate start values for proper slope visualization
    start_upper = channel_upper_display - channel_slope_display * (lenChannel - 1)
    start_middle = channel_middle_display - channel_slope_display * (lenChannel - 1)
    start_lower = channel_lower_display - channel_slope_display * (lenChannel - 1)

    upperLine := line.new(x1=start_bar, y1=start_upper, x2=bar_index, y2=channel_upper_display,
                         color=channel_color, style=line.style_dashed, width=2, extend=extend.right)
    middleLine := line.new(x1=start_bar, y1=start_middle, x2=bar_index, y2=channel_middle_display,
                          color=channel_color, style=line.style_solid, width=2, extend=extend.right)
    lowerLine := line.new(x1=start_bar, y1=start_lower, x2=bar_index, y2=channel_lower_display,
                         color=channel_color, style=line.style_dashed, width=2, extend=extend.right)

    // Enhanced slope direction label with actual slope value
    slope_text = channel_slope_display > 0 ? (channel_slope_display > nz(channel_slope_display[1], 0) ? "⇑" : "⇗") : channel_slope_display < 0 ? (channel_slope_display < nz(channel_slope_display[1], 0) ? "⇓" : "⇘") : "⇒"
    slope_style = channel_slope_display > 0 ? label.style_label_up :
                 channel_slope_display < 0 ? label.style_label_down : label.style_label_right
    slope_color = channel_slope_display > 0 ? color.green : channel_slope_display < 0 ? color.red : color.blue

    slopeLabel := label.new(x=start_bar, y=channel_middle_display, text=slope_text,
                           style=slope_style, color=slope_color, size=size.large)

///////////////////////////////////////////////////////////////////////////////
// SIGNAL GENERATION
///////////////////////////////////////////////////////////////////////////////

// Enhanced signal generation based on logistic regression
lr_bullish = ta.crossover(logistic_regression, 0.5)
lr_bearish = ta.crossunder(logistic_regression, 0.5)

// Inflecting candles (from original)
_candlesInflectUp = candlesInflectUp(close)
_candlesInflectDown = candlesInflectDown(close)

///////////////////////////////////////////////////////////////////////////////
// VISUALIZATION
///////////////////////////////////////////////////////////////////////////////

// Main MA plot with gradient coloring based on meta-analysis
colorPrimaryMA = color.from_gradient(logistic_regression, 0, 1, colorDownLR, colorUpLR)
plot(_ma_primary, color=colorPrimaryMA, linewidth=2, title="Primary MA")

// Signal shapes
plotshape(lr_bullish and bShowLRCrosses ? _ma_signal : na, title="Meta-Analysis Cross Up",
          color=colorUpLR, style=shape.triangleup, location=location.belowbar, size=size.small)
plotshape(lr_bearish and bShowLRCrosses ? _ma_signal : na, title="Meta-Analysis Cross Down",
          color=colorDownLR, style=shape.triangledown, location=location.abovebar, size=size.small)

// Inflecting candles
plotshape(_candlesInflectUp and bShowInflectingCandles ? close : na, title="Inflecting Up",
          style=shape.triangleup, location=location.belowbar, color=colorInflectingBullish, size=size.tiny)
plotshape(_candlesInflectDown and bShowInflectingCandles ? close : na, title="Inflecting Down",
          style=shape.triangledown, location=location.abovebar, color=colorInflectingBearish, size=size.tiny)

///////////////////////////////////////////////////////////////////////////////
// META-ANALYSIS DASHBOARD
///////////////////////////////////////////////////////////////////////////////

if barstate.islast
    // Create enhanced meta-analysis dashboard
    tbl = table.new(libMAs.getPosition(positionTable), IDX_MAX + 3, IDX_MAX + 3)

    // Headers
    table.cell(tbl, 0, 0, "𝗠𝗲𝘁𝗮-𝗔𝗻𝗮𝗹𝘆𝘀𝗶𝘀", text_color=color.white)
    table.cell(tbl, 1, 0, "𝗖𝗼𝗻𝗳𝗶𝗱𝗲𝗻𝗰𝗲", text_color=color.white)
    table.cell(tbl, 2, 0, "𝗜𝗻𝗽𝘂𝘁", text_color=color.white)
    table.cell(tbl, 3, 0, "𝛃", text_color=color.white)

    // Add each meta-analysis component
    for i = 0 to IDX_MAX - 1
        component_name = array.get(meta_names, i)
        confidence_val = array.get(current_confidences, i)
        input_val = array.get(current_inputs, i)
        weight_val = array.get(meta_weights, i)

        confidence_color = color.from_gradient(confidence_val, -100, 100, colorDownLR, colorUpLR)
        input_color = input_val > 0 ? colorUpLR : input_val < 0 ? colorDownLR : color.gray

        table.cell(tbl, 0, i + 1, component_name, text_color=confidence_color)
        table.cell(tbl, 1, i + 1, str.tostring(math.round(confidence_val, 1)), text_color=confidence_color)
        table.cell(tbl, 2, i + 1, str.tostring(input_val, "#.0"), text_color=input_color)
        table.cell(tbl, 3, i + 1, str.tostring(weight_val, "#.#"), text_color=color.gray)

    // Summary row
    table.cell(tbl, 0, IDX_MAX + 1, ">> Meta Regression", text_color=color.white)
    table.cell(tbl, 1, IDX_MAX + 1, str.tostring(math.round(logistic_regression, 3)), text_color=colorPrimaryMA)
    table.cell(tbl, 2, IDX_MAX + 1, logistic_regression > 0.5 ? "▲" : "▼", text_color=colorPrimaryMA)
    table.cell(tbl, 3, IDX_MAX + 1, "Consensus: " + str.tostring(consensusSteepness), text_color=color.gray)

///////////////////////////////////////////////////////////////////////////////
// LABELS (DEBUG)
///////////////////////////////////////////////////////////////////////////////

if bLabelLogisticRegression
    label.new(bar_index, logistic_regression > 0.5 ? high : low,
       text = str.tostring(math.round(logistic_regression, 3)),
       xloc = xloc.bar_index,
       yloc = logistic_regression > 0.5 ? yloc.abovebar : yloc.belowbar,
       style = label.style_none,
       textcolor = colorPrimaryMA,
       size = size.normal)

///////////////////////////////////////////////////////////////////////////////
// ALERTS
///////////////////////////////////////////////////////////////////////////////

alertcondition(lr_bullish, "Meta-Analysis UP", "Meta-Analysis Logistic Regression UP ▲")
alertcondition(lr_bearish, "Meta-Analysis DOWN", "Meta-Analysis Logistic Regression DOWN ▼")

// Channel break alerts (from original)
alertcondition(outofchannel != -1, title='Channel Broken', message='Channel Broken')

// Trend direction alerts (from original)
_trend_is_up = math.sign(channel_slope_display) != math.sign(nz(channel_slope_display[1], 0)) and channel_slope_display > 0
_trend_is_down = math.sign(channel_slope_display) != math.sign(nz(channel_slope_display[1], 0)) and channel_slope_display < 0
alertcondition(_trend_is_up, title='Up trend', message='Up trend')
alertcondition(_trend_is_down, title='Down trend', message='Down trend')

// Comprehensive alert message
alert_msg = "Enhanced Meta-Analysis: " + str.tostring(math.round(logistic_regression, 3)) +
           (logistic_regression > 0.5 ? " ▲" : " ▼") +
           " | Consensus: " + str.tostring(math.round(raw_meta_consensus, 2)) +
           " | Fast: " + str.tostring(math.round(array.get(current_confidences, IDX_CONFIDENCE_FAST), 0)) +
           " | Med: " + str.tostring(math.round(array.get(current_confidences, IDX_CONFIDENCE_MEDIUM), 0)) +
           " | Slow: " + str.tostring(math.round(array.get(current_confidences, IDX_CONFIDENCE_SLOW), 0)) +
           " | ATR: " + str.tostring(math.round(array.get(current_confidences, IDX_ATR_DISTANCE), 0)) +
           " | Vol: " + str.tostring(math.round(array.get(current_confidences, IDX_VOLUME_ANALYSIS), 0))

if lr_bullish or lr_bearish
    alert(alert_msg, alert.freq_once_per_bar_close)