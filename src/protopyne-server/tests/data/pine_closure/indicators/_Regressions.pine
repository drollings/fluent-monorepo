atrExit = input.float(3.0, "Exit Threshold", step=0.25, minval=1.0, maxval=10.0, group=sATRHeader, inline="ATR")

// Divergence Analysis Settings
const string sDivergenceHeader = "Divergence Analysis"
divergenceLookback = input.int(14, "Lookback Period", minval=5, maxval=50, group=sDivergenceHeader, inline="Div")
