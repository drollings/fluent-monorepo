import showmethegrail/libDrawing/61 as libDrawing

///////////////////////////////////////////////////////////////////////////////
// CONSTANTS
///////////////////////////////////////////////////////////////////////////////

const float VOLUME_EPSILON = 0.0001
const float PRICE_EPSILON = 0.001
const int BUFFER_PADDING = 5
const float NEUTRAL_BUY_RATIO = 0.5
const float BUY_RATIO_UP = 0.8
const float BUY_RATIO_DOWN = 0.2
const int MAX_BINS = 600
const int MAX_LTF_BARS = 10000
const int MIN_REBUILD_BARS = 10
const int DEFAULT_BIN_PADDING = 40
const float ALPHA_DEFAULT = 0.08
const float ALPHA_MIN = 0.01
const float ALPHA_MAX = 0.9

/////////////////////////////////////////////////////////////
// DIAGNOSTIC INPUTS
/////////////////////////////////////////////////////////////

const string GROUP_DIAGNOSTIC = "Diagnostic"
i_show_diagnostic = input.bool(true, "Show Profile Diagnostic Table", group=GROUP_DIAGNOSTIC)
// i_show_bars_diagnostic = input.bool(true, "Show Bars Diagnostic Table", group=GROUP_DIAGNOSTIC)
// i_show_audit_diagnostic = input.bool(true, "Show Audit Diagnostic Table", group=GROUP_DIAGNOSTIC)
// i_enable_audit = input.bool(true, "Enable LTF Audit (Covariance Check)", group=GROUP_DIAGNOSTIC)
i_log_enabled = input.bool(false, "Enable Logging", group=GROUP_DIAGNOSTIC)

///////////////////////////////////////////////////////////////////////////////
// UTILITY FUNCTIONS
///////////////////////////////////////////////////////////////////////////////

// @function Calculate volume drift percentage
calculateDriftPct(float actual, float expected) =>
    expected > VOLUME_EPSILON ? math.abs(actual - expected) / expected * 100.0 : 0.0

// @function Validate volume is meaningful
isValidVolume(float vol) =>
    not na(vol) and vol > VOLUME_EPSILON

// @function Safe division with default
safeDivide(float num, float den, float default_val = 0.0) =>
    den > VOLUME_EPSILON ? num / den : default_val

// @function Get candle index from timestamp
getCandleIndex(int timestamp, int candle_ms) =>
    int(math.floor(timestamp / candle_ms))

