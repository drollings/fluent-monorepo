// @enum SweepType - Types of liquidity sweeps
export enum SweepType
    NO_SWEEP = "No Sweep"
    PARTIAL_SWEEP = "Partial Sweep"
    FULL_SWEEP = "Full Sweep"
    STOP_HUNT = "Stop Hunt"

// @type OrderBlock - Institutional order block data
export type OrderBlock
    float mitigation_price = na
    float volume_confirmation = 0.0
    int creation_bar = na
    float atr_distance = 0.0

// @type FairValueGap - Price imbalance zone
export type FairValueGap
    float gap_size = na
    bool is_filled = false
    float fill_percentage = 0.0
    int creation_time = na

// @type LiquidityZone - Stop hunt/sweep area
export type LiquidityZone
    SweepType sweep_type = SweepType.NO_SWEEP
    float hunt_completion_percent = 0.0
    array<float> sweep_levels = na

// @type StructureBreak - BOS/CHoCH detection
export type StructureBreak
    string break_type = na        // "BOS" or "CHoCH"
    int break_bar = na
    float conviction_score = 0.0

// @type MarketLevel - Comprehensive swing level with ICT classification
export type MarketLevel
    int id = 0
    // Core spatial and temporal bounds
    float price_high = na
    float price_low = na
    int creation_bar = na
    int last_touch_bar = na
    int last_active_bar = na
    int last_success_bar = na

    // Visuals
    int zone_id = na

    // State and lifecycle management
    int direction = na                // 1 bullish, -1 bearish
    float pressure = 0.0                // If positive, pressure pushes price in according to the direction field.  of direction.  If negative, draws price action towards itself, i.e. liquidity pools, fair value gaps, etc.
    int touch_count = 0
    int successes = 0
    int aged = 0                        // Total age of level
    int aged_outside_profile = 0        // Age only when outside profile range
    int breach_count = 0                // Count of confirmed breaches/flips

    // Flags
    bool is_sr = false                  // RENAMED: true if level can act as support or resistance
    bool is_magnetic = false            // If true, this level tends to draw price action towards it - liquidity pools, fair value gaps

    // Composition - specialized structure types (replaces booleans)
    UTIL.CandlePatterns pattern = UTIL.CandlePatterns.NA
    OrderBlock order_block = na
    FairValueGap fvg = na
    LiquidityZone liquidity_zone = na
    StructureBreak structure_break = na

///////////////////////////////////////////////////////////////////////////////
// MARKET LEVEL METHODS
///////////////////////////////////////////////////////////////////////////////

export method init(MarketLevel this, float price_low, float price_high, int pivot_bar, int direction) =>
    this.price_low := price_low
    this.price_high := price_high
    this.creation_bar := pivot_bar
    this.last_touch_bar := pivot_bar
    this.last_active_bar := pivot_bar
    this.last_success_bar := pivot_bar
    this.touch_count := 1
    this.successes := 1
    this.is_sr := true
    this.direction := direction
    this

// @function clean
// @description Cleans up the MarketLevel object by setting certain properties and arrays to na.
// @param this: MarketLevel - The MarketLevel object to be cleaned.
// @returns MarketLevel - The cleaned MarketLevel object, indicated by returning na.
export method clean(MarketLevel this) =>
    if not na(this)
        // Clear composition data
        this.order_block := na
        this.fvg := na
        this.liquidity_zone := na
        this.structure_break := na

        // Clear arrays
        if not na(this.liquidity_zone) and not na(this.liquidity_zone.sweep_levels)
            array.clear(this.liquidity_zone.sweep_levels)

    // Return na to indicate cleaned object
    this

// @function updateLevelSuccess
// @description Updates a market level with successful interaction data
// @param level: MarketLevel - The level to update
// @param current_bar: int - Current bar index
// @param o: float - Open price
// @param h: float - High price
// @param l: float - Low price
// @param c: float - Close price
// @param v: float - Volume
// @returns MarketLevel - The updated level
export method updateLevelSuccess(MarketLevel level, int current_bar) =>
    if not na(level)
        level.aged := 0
        level.successes += 1
        level.last_success_bar := current_bar
        level.last_active_bar := current_bar
    level

// @function updateLevelTouch
// @description Updates a market level with touch data
// @param level: MarketLevel - The level to update
// @param current_bar: int - Current bar index
// @param is_successful: bool - Whether the touch was successful
// @param o: float - Open price (optional, for success updates)
// @param h: float - High price (optional, for success updates)
// @param l: float - Low price (optional, for success updates)
// @param c: float - Close price (optional, for success updates)
// @param v: float - Volume (optional, for success updates)
// @returns MarketLevel - The updated level
export method updateLevelTouch(MarketLevel level, int current_bar, bool is_successful, float v = na) =>
    if not na(level)
        level.touch_count += 1
        level.last_touch_bar := current_bar
        if is_successful and not na(v)
            level.updateLevelSuccess(current_bar)
        else
            level.last_active_bar := current_bar
    level

// @function breakLevel
// @description Weakens a level after being broken
// @param level: MarketLevel - The level to break
// @param current_bar: int - Current bar index
// @returns MarketLevel - The weakened level
export method breakLevel(MarketLevel level, int current_bar) =>
    if not na(level)
        level.touch_count += 1
        level.pressure := level.pressure / 2.0
        level.last_active_bar := current_bar
    level

// @function binarySearchMarketLevels
// @description Searches for the position in the sorted array where the given price would fit, using binary search.
// @param arr: array<MarketLevel> - The sorted array of MarketLevel objects.
// @param price: float - The price to search for in the array.
// @returns int - The index where the price would fit in the array.
export binarySearchMarketLevels(array<MarketLevel> arr, float price) =>
    if na(arr) or array.size(arr) == 0
        0
    else
        left = 0
        right = array.size(arr)
        while left < right
            mid = math.floor((left + right) / 2)
            mid_level = array.get(arr, mid)
            if not na(mid_level) and not na(mid_level.price_low) and mid_level.price_low < price
                left := mid + 1
            else
                right := mid
        left

// @function flip
// @description Determines if a market level flip occurs based on breach direction and current market conditions
// @param this: MarketLevel - The market level object being evaluated
// @param current_price: float - The current market price
// @param breach_direction: int - The direction of price breach (1 for bullish, -1 for bearish)
// @returns bool - True if level flip occurs, false otherwise
export method flip(MarketLevel this, float current_price, int breach_direction) =>
    if na(this) or na(current_price) or breach_direction == 0
        false
    else
        if this.is_sr
            // Progressive weakening: each breach weakens more
            // First flip: ~50%, Second: ~42%, Third: ~35%, etc.
            decay_factor = math.pow(0.5, 1.0 + (this.breach_count * 0.2))
            this.pressure *= decay_factor
            this.breach_count += 1

        // Perform the flip
        this.direction := breach_direction
        this.last_active_bar := bar_index

        true

// @function remove
// @description Removes a MarketLevel object and cleans up its visual representations
// @param this: MarketLevel - The MarketLevel object to remove
// @param visuals: libDrawing.DrawingManager - The visual manager to handle drawing cleanup
// @param show_static_outline: bool - Whether to make the visual static instead of fully removing
// @returns MarketLevel - Returns na to indicate the object has been cleaned up
export method remove(MarketLevel this, libDrawing.DrawingManager visuals, bool show_static_outline = false) =>
    if not na(this)
        // Clean up visual zone if it exists
        if not na(this.zone_id)
            visuals.disableAutoExtend(this.zone_id)

            // Conditionally make static or fully remove
            if show_static_outline
                visuals.makeStatic(this.zone_id)
            else
                visuals.remove(this.zone_id)

            this.zone_id := na

        this.clean()

    // Return na to indicate cleaned object
    this

// @function createNewZoneWithProfile
// @description Creates a new zone with a profile visual and returns the zone ID or na if creation failed.
// @param this: MarketLevel - The market level object containing zone data and configuration.
// @param visuals: libDrawing.DrawingManager - The drawing manager instance for managing visual elements.
// @param content: string - The content string to display within the zone label.
// @param color_support: color - The color used for support zones (default: teal).
// @param color_resistance: color - The color used for resistance zones (default: orange).
// @returns series int - The ID of the created zone, or na if the zone was not created.
export method createNewZoneWithProfile(MarketLevel this, libDrawing.DrawingManager visuals, string content, color color_support = color.teal, color color_resistance = color.orange) =>
    // Check if creation_bar is within historical buffer limits
    max_lookback = 500
    safe_creation_bar = this.creation_bar

    if bar_index - this.creation_bar > max_lookback
        safe_creation_bar := bar_index - max_lookback + 50

    level_color = this.direction == 1 ? color_support : (this.direction == -1 ? color_resistance : UTIL.COLOR_NEUTRAL)

    // Create the main visual zone
    zone = visuals.addLabeledZone(
         "zone_" + str.tostring(this.id),
         safe_creation_bar,
         this.price_low,
         this.price_high,
         color.new(level_color, 75),
         color.new(level_color, 100),
         content)

    if not na(zone)
        this.zone_id := zone.id
        zone.id
    else
        na

// @function draw
// @description Draws a market level zone on the chart using the provided drawing manager and content.
// @param this: MarketLevel - The market level instance containing zone and direction data.
// @param visuals: libDrawing.DrawingManager - The drawing manager to handle visual elements.
// @param content: string - The text content to display within the zone.
// @param color_support: color - The color used for support levels (default: teal).
// @param color_resistance: color - The color used for resistance levels (default: orange).
// @returns string - The ID of the created or updated zone.
export method draw(MarketLevel this, libDrawing.DrawingManager visuals, string content, color color_support = color.teal, color color_resistance = color.orange) =>
    if not na(this.zone_id) and visuals.contains(this.zone_id)
        // Update existing zone
        box_element = visuals.getElement(this.zone_id)
        if not na(box_element)
            level_color = this.direction == 1 ? color_support : (this.direction == -1 ? color_resistance : UTIL.COLOR_NEUTRAL)
            visuals.setStyle(this.zone_id,
                 bg = color.new(level_color, math.max(80, 95-this.pressure/8.0)),
                 fg = color.new(level_color, 30))

            visuals.setStyle(this.zone_id, content = content)

            this.zone_id
        else
            this.createNewZoneWithProfile(visuals, content)
    else
        this.createNewZoneWithProfile(visuals, content)
