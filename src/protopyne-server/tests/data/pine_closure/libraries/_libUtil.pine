// @enum Signal constants for backtest adapter compatibility
export const int SIGNAL_NONE = 0
export const int SIGNAL_BULL_ENTRY = 1
export const int SIGNAL_BULL_EXIT = 2
export const int SIGNAL_BEAR_ENTRY = -1
export const int SIGNAL_BEAR_EXIT = -2

export const float OSC_UPPER_BOUND = 200.0
export const float OSC_UPPER_THRESHOLD = 50.0
export const float OSC_UPPER_RANGE = 10.0
export const float OSC_CENTER = 0.0
export const float OSC_LOWER_RANGE = -10.0
export const float OSC_LOWER_THRESHOLD = -50.0
export const float OSC_LOWER_BOUND = -200.0
export const float OSC_RANGE_WIDTH = OSC_UPPER_RANGE - OSC_LOWER_RANGE

export const color COLOR_NONE = color.rgb(0,0,0,100.0)
export const color COLOR_NEUTRAL = color.rgb(40, 40, 40, 60)

/////////////////////////////////////////////////////////////
// TIMEFRAME ENUM AND UTILITY FUNCTIONS
/////////////////////////////////////////////////////////////

//@enum An enumeration of timeframes
export enum Timeframes
    C = "Chart"
    S5 = "5 Seconds"
    S10 = "10 Seconds"
    S15 = "15 Seconds"
    S30 = "30 Seconds"
    M1 = "1 Minute"
    M3 = "3 Minutes"
    M5 = "5 Minutes"
    M10 = "10 Minutes"
    M15 = "15 Minutes"
    M30 = "30 Minutes"
    H1 = "1 Hour"
    H2 = "2 Hours"
    H4 = "4 Hours"
    D1 = "1 Day"
    W1 = "1 Week"
    MO1 = "1 Month"
    MO3 = "3 Months"
    Y = "Year"
    NA = "-"

// @function getTimeframeAbbrev
// @description Returns the abbreviated string representation of a given timeframe.
// @param tf: Timeframes - The timeframe to convert to an abbreviated string.
// @returns string - The abbreviated string representation of the timeframe.
export getTimeframeAbbrev(Timeframes tf) =>
    switch tf
        Timeframes.NA => timeframe.period
        Timeframes.C => timeframe.period
        Timeframes.S5 => "5S"
        Timeframes.S10 => "10S"
        Timeframes.S15 => "15S"
        Timeframes.S30 => "30S"
        Timeframes.M1 => "1"
        Timeframes.M3 => "3"
        Timeframes.M5 => "5"
        Timeframes.M10 => "10"
        Timeframes.M15 => "15"
        Timeframes.M30 => "30"
        Timeframes.H1 => "60"
        Timeframes.H2 => "120"
        Timeframes.H4 => "240"
        Timeframes.D1 => "D"
        Timeframes.W1 => "W"
        Timeframes.MO1 => "1M"
        Timeframes.MO3 => "3M"
        Timeframes.Y => "12M"
        =>
            runtime.error("Unknown timeframe enum value")
            timeframe.period

// @function getTimeframeMS
// @description Returns the millisecond representation of a given time frame.
// @param tf: Timeframes - The time frame to convert to milliseconds.
// @returns int - The millisecond representation of the time frame.
export getTimeframeMS(Timeframes tf) =>
    switch tf
        Timeframes.S5 => 5000
        Timeframes.S10 => 10000
        Timeframes.S15 => 15000
        Timeframes.S30 => 30000
        Timeframes.M1 => 60000
        Timeframes.M3 => 180000
        Timeframes.M5 => 300000
        Timeframes.M10 => 600000
        Timeframes.M15 => 900000
        Timeframes.M30 => 1800000
        Timeframes.H1 => 3600000
        Timeframes.H2 => 7200000
        Timeframes.H4 => 14400000
        Timeframes.D1 => 86400000
        Timeframes.W1 => 604800000
        =>
            timeframe.in_seconds(timeframe.period) * 1000

// @function getTimeframeFromMS
// @description Converts a given interval in milliseconds to the corresponding Pine Script timeframe.
// @param interval_ms: int - The interval in milliseconds to convert.
// @returns Timeframes - The corresponding Pine Script timeframe for the given interval.
export getTimeframeFromMS(int interval_ms) =>
    switch interval_ms
        5000 => Timeframes.S5
        15000 => Timeframes.S15
        30000 => Timeframes.S30
        60000 => Timeframes.M1
        300000 => Timeframes.M5
        600000 => Timeframes.M10
        900000 => Timeframes.M15
        1800000 => Timeframes.M30
        3600000 => Timeframes.H1
        14400000 => Timeframes.H4
        86400000 => Timeframes.D1
        604800000 => Timeframes.W1
        =>
            Timeframes.NA

// @function getTimeframeFromMultiplier
// @description Returns the closest timeframe to a given multiple of the input time frame.
// @param tf: Timeframes - The input time frame to determine the anchor for.
// @param multiple: The multiple of the given timeframe to seek
// @returns Timeframes - The closest Timeframes enum to getTimeframeMS(tf) * target
export getTimeframeFromMultiplier(Timeframes tf, float multiple) =>
    int target = int(math.round(getTimeframeMS(tf) * multiple, 0))
    foundTF = getTimeframeFromMS(target)

    if foundTF == Timeframes.NA
        a = array.from(5000, 15000, 30000, 60000, 300000, 600000, 900000, 1800000, 3600000, 7200000, 14400000, 86400000, 604800000)
        idx = math.min(array.binary_search_leftmost(a, target), 13)
        foundTF := getTimeframeFromMS(array.get(a, idx))
        array.clear(a)
    foundTF

// @function getTimeframe
// @description Returns the corresponding Pine Script timeframe constant for a given period string.
// @param _period: string - The period string to convert to a timeframe constant.
// @returns Timeframes - The corresponding Pine Script timeframe constant.
export getTimeframe(string _period = timeframe.period) =>
    switch _period
        // Seconds timeframes
        "5S" => Timeframes.S5
        "10S" => Timeframes.S10
        "15S" => Timeframes.S15
        "30S" => Timeframes.S30

        // Minutes timeframes
        "1" => Timeframes.M1
        "1M" => Timeframes.M1
        "3" => Timeframes.M3
        "3M" => Timeframes.M3
        "5" => Timeframes.M5
        "5M" => Timeframes.M5
        "10" => Timeframes.M10
        "10M" => Timeframes.M10
        "15" => Timeframes.M15
        "15M" => Timeframes.M15
        "30" => Timeframes.M30
        "30M" => Timeframes.M30

        // Hours timeframes
        "60" => Timeframes.H1
        "1H" => Timeframes.H1
        "120" => Timeframes.H2
        "2H" => Timeframes.H2
        "240" => Timeframes.H4
        "4H" => Timeframes.H4

        // Daily timeframes
        "D" => Timeframes.D1
        "1D" => Timeframes.D1

        // Weekly timeframes
        "W" => Timeframes.W1
        "1W" => Timeframes.W1

        // Monthly timeframes
        "1M" => Timeframes.MO1
        "M1" => Timeframes.MO1
        "3M" => Timeframes.MO3
        "M3" => Timeframes.MO3
        "12M" => Timeframes.Y
        "Y" => Timeframes.Y

        // Default case
        => Timeframes.NA

// @function getBarsInTimeframes
// @description Calculates the number of lower timeframe bars that fit into a higher timeframe bar.
// @param lowerTf: Timeframes - The lower timeframe to compare against.
// @param higherTf: Timeframes - The higher timeframe to compare against.
// @returns int - The number of lower timeframe bars that fit into a higher timeframe bar.
export getBarsInTimeframes(Timeframes lowerTf, Timeframes higherTf) =>
    int lowerSeconds = getTimeframeMS(lowerTf)
    int higherSeconds = getTimeframeMS(higherTf)

    // The conditional logic is now handled by a ternary operator in a single line.
    // This allows the entire expression to be resolved at compile time.
    int retval = 1
    retval := not na(higherSeconds) and not na(lowerSeconds) and lowerSeconds < higherSeconds ? int(higherSeconds / lowerSeconds) : 1
    retval

// @function isChartTimeframe
// @description Determines if the current chart timeframe matches the specified target timeframe.
// @param target_tf: Timeframes - The target timeframe to compare against the current chart's timeframe.
// @returns bool - True if the current chart's timeframe matches the target timeframe, false otherwise.
export isChartTimeframe(Timeframes target_tf) =>
    target_tf == getTimeframe(timeframe.period)

