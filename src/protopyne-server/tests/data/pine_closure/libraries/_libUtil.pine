    EVENING_STAR = "Evening Star"
    GRAVESTONE_DOJI = "Gravestone Doji"
    HAMMER = "Hammer"
    HANGING_MAN = "Hanging Man"
    HARAMI_BULL = "Harami Bull"
    HARAMI_BEAR = "Harami Bear"
    HARAMI_CROSS = "Harami Cross"
    INFLECTION_UP = "Inflection Up"
    INFLECTION_DOWN = "Inflection Down"
    INVERTED_HAMMER = "Inverted Hammer"
    KICKING_BULL = "Kicking Bull"
    KICKING_BEAR = "Kicking Bear"
    LONG_LOWER_SHADOW = "Long Lower Shadow"
    LONG_UPPER_SHADOW = "Long Upper Shadow"
    MARUBOZU_WHITE = "Marubozu White"
    MARUBOZU_BLACK = "Marubozu Black"
    MORNING_DOJI_STAR = "Morning Doji Star"
    MORNING_STAR = "Morning Star"
    PIERCING_LINE = "Piercing Line"
    SHOOTING_STAR = "Shooting Star"
    BULL_SPINNING_TOP = " Bull Spinning Top"
    BEAR_SPINNING_TOP = "Bear Spinning Top"
    THREE_WHITE_SOLDIERS = "Three White Soldiers"
    THREE_BLACK_CROWS = "Three Black Crows"
    TWEEZER_TOP = "Tweezer Top"
    TWEEZER_BOTTOM = "Tweezer Bottom"

    // SMC-Specific Patterns
    LIQUIDITY_GRAB_BULL = "Liquidity Grab Bull"
    LIQUIDITY_GRAB_BEAR = "Liquidity Grab Bear"
    INDUCEMENT_BULL = "Inducement Bull"
    INDUCEMENT_BEAR = "Inducement Bear"
    DISPLACEMENT_BULL = "Displacement Bull"
    DISPLACEMENT_BEAR = "Displacement Bear"
    MITIGATION_TEST_BULL = "Mitigation Test Bull"
    MITIGATION_TEST_BEAR = "Mitigation Test Bear"
    ACCUMULATION = "Accumulation"
    DISTRIBUTION = "Distribution"
    WYCKOFF_SPRING = "Wyckoff Spring"
    WYCKOFF_UPTHRUST = "Wyckoff Upthrust"
    STOP_HUNT = "Stop Hunt"
    FAIR_VALUE_REBALANCE = "Fair Value Rebalance"

    NA = "-"

// @function isPatternType
// @description Checks if a given candle pattern matches the specified pattern type.
// @param pattern: CandlePatterns - The candle pattern to evaluate.
// @param type: PatternTypes - The type of pattern to check against.
// @returns bool - True if the pattern matches the specified type, false otherwise.
export isPatternType(CandlePatterns pattern, PatternTypes type) =>
    switch type
        PatternTypes.BULLISH =>
            switch pattern
                CandlePatterns.DRAGONFLY_DOJI => true
                CandlePatterns.MARUBOZU_WHITE => true
                CandlePatterns.HAMMER => true
                CandlePatterns.INVERTED_HAMMER => true
                CandlePatterns.ENGULFING_BULL => true
                CandlePatterns.MORNING_STAR => true
                CandlePatterns.MORNING_DOJI_STAR => true
                CandlePatterns.THREE_WHITE_SOLDIERS => true
                CandlePatterns.HARAMI_BULL => true
                CandlePatterns.INFLECTION_UP => true
                CandlePatterns.PIERCING_LINE => true
                CandlePatterns.TWEEZER_BOTTOM => true
                CandlePatterns.ABANDONED_BABY_BULL => true
                CandlePatterns.BULL_SPINNING_TOP => true
                CandlePatterns.KICKING_BULL => true
                CandlePatterns.LONG_LOWER_SHADOW => true
                CandlePatterns.LIQUIDITY_GRAB_BULL => true
                CandlePatterns.INDUCEMENT_BULL => true
                CandlePatterns.DISPLACEMENT_BULL => true
                CandlePatterns.MITIGATION_TEST_BULL => true
                CandlePatterns.WYCKOFF_SPRING => true
                => false

        PatternTypes.BEARISH =>
            switch pattern
                CandlePatterns.GRAVESTONE_DOJI => true
                CandlePatterns.MARUBOZU_BLACK => true
                CandlePatterns.HANGING_MAN => true
                CandlePatterns.SHOOTING_STAR => true
                CandlePatterns.ENGULFING_BEAR => true
                CandlePatterns.EVENING_STAR => true
                CandlePatterns.EVENING_DOJI_STAR => true
                CandlePatterns.THREE_BLACK_CROWS => true
                CandlePatterns.HARAMI_BEAR => true
                CandlePatterns.INFLECTION_DOWN => true
                CandlePatterns.DARK_CLOUD_COVER => true
                CandlePatterns.TWEEZER_TOP => true
                CandlePatterns.ABANDONED_BABY_BEAR => true
                CandlePatterns.BEAR_SPINNING_TOP => true
                CandlePatterns.KICKING_BEAR => true
                CandlePatterns.LONG_UPPER_SHADOW => true
                CandlePatterns.LIQUIDITY_GRAB_BEAR => true
                CandlePatterns.INDUCEMENT_BEAR => true
                CandlePatterns.DISPLACEMENT_BEAR => true
                CandlePatterns.MITIGATION_TEST_BEAR => true
                CandlePatterns.WYCKOFF_UPTHRUST => true
                => false

        PatternTypes.NEUTRAL =>
            switch pattern
                CandlePatterns.DOJI => true
                CandlePatterns.HARAMI_CROSS => true
                CandlePatterns.ACCUMULATION => true
                CandlePatterns.DISTRIBUTION => true
                CandlePatterns.STOP_HUNT => true
                CandlePatterns.FAIR_VALUE_REBALANCE => true
                => false

        PatternTypes.REVERSAL =>
            switch pattern
                CandlePatterns.DOJI => true
                CandlePatterns.DRAGONFLY_DOJI => true
                CandlePatterns.GRAVESTONE_DOJI => true
                CandlePatterns.HAMMER => true
                CandlePatterns.HANGING_MAN => true
                CandlePatterns.INVERTED_HAMMER => true
                CandlePatterns.SHOOTING_STAR => true
                CandlePatterns.ENGULFING_BULL => true
                CandlePatterns.ENGULFING_BEAR => true
                CandlePatterns.MORNING_STAR => true
                CandlePatterns.EVENING_STAR => true
                CandlePatterns.MORNING_DOJI_STAR => true
                CandlePatterns.EVENING_DOJI_STAR => true
                CandlePatterns.HARAMI_BULL => true
                CandlePatterns.HARAMI_BEAR => true
                CandlePatterns.HARAMI_CROSS => true
                CandlePatterns.PIERCING_LINE => true
                CandlePatterns.DARK_CLOUD_COVER => true
                CandlePatterns.TWEEZER_TOP => true
                CandlePatterns.TWEEZER_BOTTOM => true
                CandlePatterns.ABANDONED_BABY_BULL => true
                CandlePatterns.ABANDONED_BABY_BEAR => true
                CandlePatterns.BULL_SPINNING_TOP => true
                CandlePatterns.BEAR_SPINNING_TOP => true
                CandlePatterns.KICKING_BULL => true
                CandlePatterns.KICKING_BEAR => true
                CandlePatterns.LONG_LOWER_SHADOW => true
                CandlePatterns.LONG_UPPER_SHADOW => true
                CandlePatterns.LIQUIDITY_GRAB_BULL => true
                CandlePatterns.LIQUIDITY_GRAB_BEAR => true
                CandlePatterns.INDUCEMENT_BULL => true
                CandlePatterns.INDUCEMENT_BEAR => true
                CandlePatterns.WYCKOFF_SPRING => true
                CandlePatterns.WYCKOFF_UPTHRUST => true
                CandlePatterns.STOP_HUNT => true
                => false

        PatternTypes.CONTINUATION =>
            switch pattern
                CandlePatterns.MARUBOZU_WHITE => true
                CandlePatterns.MARUBOZU_BLACK => true
                CandlePatterns.THREE_WHITE_SOLDIERS => true
                CandlePatterns.THREE_BLACK_CROWS => true
                CandlePatterns.DISPLACEMENT_BULL => true
                CandlePatterns.DISPLACEMENT_BEAR => true
                CandlePatterns.MITIGATION_TEST_BULL => true
                CandlePatterns.MITIGATION_TEST_BEAR => true
                CandlePatterns.FAIR_VALUE_REBALANCE => true
                => false

        => false

/////////////////////////////////////////////////////////////
// CORE UTILITY FUNCTIONS
/////////////////////////////////////////////////////////////

// @function risingMeterChar
// @description Returns a character representing a rising meter based on the given value.
// @param value: float - The value to determine the meter character.
// @returns string - A character representing the meter level.
export risingMeterChar(float value) =>
    switch math.floor(value * 8)
        1 => '_'
        2 => '▁'
        3 => '▂'
        4 => '▃'
        5 => '▄'
        6 => '▅'
        7 => '▇'
        8 => '█'
        => ' '

// @function tanh
// @description Calculates the hyperbolic tangent of a given float value.
// @param x: float - The input value for which to calculate the hyperbolic tangent.
// @returns float - The hyperbolic tangent of the input value.
export tanh(float x) =>
    exp_2x = math.exp(2 * x)
    (exp_2x - 1) / (exp_2x + 1)

// @function fast_tanh
// @description Returns a fast approximation of the hyperbolic tangent of a given float value.
// @param x: float - The input value for which to compute the fast hyperbolic tangent.
// @returns float - The fast approximation of the hyperbolic tangent of x.
export fast_tanh(float x) =>
    x / (1 + math.abs(x))

// @function safeDivide
// @description Safely divides two numbers, returning a default value if division is not possible.
// @param numerator: float - The number to be divided.
// @param denominator: float - The number to divide by.
// @param defaultValue: float - The value to return if division is not possible (default is 0.0).
// @returns float - The result of the division or the default value if division is not possible.
export safeDivide(float numerator, float denominator, float defaultValue = 0.0) =>
    if na(numerator) or na(denominator) or denominator == 0
        defaultValue
    else
        numerator / denominator

// @function sameSign
// @description Returns true if both input values have the same sign, false otherwise.
// @param val1: float - The first value to compare.
// @param val2: float - The second value to compare.
// @returns boolean - True if both values have the same sign, false otherwise.
export sameSign(float val1, float val2) =>
    if na(val1) or na(val2)
        false
    else
        (val1 >= 0 and val2 >= 0) or (val1 < 0 and val2 < 0)

// @function safeArrayAccess
// @description Returns a safe access to an element in an array, returning a default value if the index is out of bounds.
// @param arr: array<float> - The array to access.
// @param idx: int - The index to access in the array.
// @param defaultValue: float - The default value to return if the index is out of bounds (default is 0.0).
// @returns float - The accessed element or the default value if the index is out of bounds.
export safeArrayAccess(array<float> arr, int idx, float defaultValue = 0.0) =>
    if na(arr) or na(idx) or idx < 0 or idx >= array.size(arr)
        defaultValue
    else
        array.get(arr, idx)

//@enum UI sizes for elements
export enum Sizes
    AUTO = "Auto"
    TINY = "Tiny"
    SMALL = "Small"
    NORMAL = "Normal"
    LARGE = "Large"
    HUGE = "Huge"

//@enum Line styles
export enum LineStyles
    SOLID = "Solid"
    DOTTED = "Dotted"
    DASHED = "Dashed"

//@enum Table positions
export enum Positions
    TOP_LEFT = "Top Left"
    TOP_CENTER = "Top Center"
    TOP_RIGHT = "Top Right"
    MIDDLE_LEFT = "Middle Left"
    MIDDLE_CENTER = "Middle Center"
    MIDDLE_RIGHT = "Middle Right"
    BOTTOM_LEFT = "Bottom Left"
    BOTTOM_CENTER = "Bottom Center"
    BOTTOM_RIGHT = "Bottom Right"
    TOP_LEFT_PANE = "Top Left Pane"
    TOP_RIGHT_PANE = "Top Right Pane"
    BOTTOM_LEFT_PANE = "Bottom Left Pane"
    BOTTOM_RIGHT_PANE = "Bottom Right Pane"

//@enum Line types for different drawing patterns
export enum LineType
    HORIZONTAL = "Horizontal"
    VERTICAL = "Vertical"
    ANGLED = "Angled"
    DIRECT = "Direct"

//@enum Extension behavior for lines
export enum ExtensionType
    FIXED = "Fixed"
    EXTENDING = "Extending"
    CONDITIONAL = "Conditional"
    TEMPORARY = "Temporary"

/////////////////////////////////////////////////////////////
// UI UTILITY FUNCTIONS
/////////////////////////////////////////////////////////////

// @function getSize
// @description Returns the appropriate size based on the provided Sizes enum value.
// @param s: Sizes - The size enum value to convert to a specific size.
// @returns size - The corresponding size value for the given Sizes enum.
export getSize(Sizes s) =>
    switch s
        Sizes.AUTO => size.auto
        Sizes.TINY => size.tiny
        Sizes.SMALL => size.small
        Sizes.NORMAL => size.normal
        Sizes.LARGE => size.large
        Sizes.HUGE => size.huge
        =>
            runtime.error("Unknown size enum value")
            size.auto

// @function getLineStyle
// @description Returns a line style based on the provided LineStyles enum value.
// @param s: LineStyles - The line style to convert to a Pine Script line style.
// @returns line.style - The corresponding Pine Script line style.
export getLineStyle(LineStyles s) =>
    switch s
        LineStyles.SOLID => line.style_solid
        LineStyles.DOTTED => line.style_dotted
        LineStyles.DASHED => line.style_dashed
        =>
            runtime.error("Unknown line style enum value")
            line.style_dotted

// @function getPosition
// @description Returns the position based on the provided Positions enum value.
// @param pos: Positions - The Positions enum value to determine the position.
// @returns position - The corresponding position based on the Positions enum value.
export getPosition(Positions pos) =>
    switch pos
        Positions.TOP_LEFT => position.top_left
        Positions.TOP_CENTER => position.top_center
        Positions.TOP_RIGHT => position.top_right
        Positions.MIDDLE_LEFT => position.middle_left
        Positions.MIDDLE_CENTER => position.middle_center
        Positions.MIDDLE_RIGHT => position.middle_right
        Positions.BOTTOM_LEFT => position.bottom_left
        Positions.BOTTOM_CENTER => position.bottom_center
        Positions.BOTTOM_RIGHT => position.bottom_right
        Positions.TOP_LEFT_PANE => position.top_left
        Positions.TOP_RIGHT_PANE => position.top_right
        Positions.BOTTOM_LEFT_PANE => position.bottom_left
        Positions.BOTTOM_RIGHT_PANE => position.bottom_right
        =>
            runtime.error("Unknown position enum value")
            position.middle_center

// @function isPositionOverlay
// @description Determines if a given position is not in the middle panes.
// @param pos: Positions - The position to check.
// @returns bool - True if the position is not in the middle panes, false otherwise.
export isPositionOverlay(Positions pos) =>
    not array.includes(array.from(Positions.TOP_LEFT_PANE, Positions.TOP_RIGHT_PANE, Positions.BOTTOM_LEFT_PANE, Positions.BOTTOM_RIGHT_PANE), pos)

