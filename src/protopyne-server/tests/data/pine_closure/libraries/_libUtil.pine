// Regime detection (add after MarketRegimes enum)
export enum MarketRegimes
    RANGING = "Ranging"
    TRENDING_BULL = "Trending Bull"
    TRENDING_BEAR = "Trending Bear"
    VOLATILE = "Volatile"
    LOW_VOLUME = "Low Volume"

// @function getRegimeEmoji
// @description Returns an emoji corresponding to the given market regime.
// @param regime: MarketRegimes - The market regime to get the emoji for.
// @returns string - The emoji representing the market regime.
export getRegimeEmoji(MarketRegimes regime) =>
    switch regime
        MarketRegimes.RANGING => "⚖"
        MarketRegimes.TRENDING_BULL => "🐂"
        MarketRegimes.TRENDING_BEAR => "🐻"
        MarketRegimes.VOLATILE => "⚡"
        MarketRegimes.LOW_VOLUME => "💤"
        => "❓"

