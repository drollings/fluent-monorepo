//@version=6

// @description Unified Buffer Library - Array and Ring Buffer functionality
// Provides statistical analysis, correlation, regression, and data manipulation functions
// Supports both dynamic array mode (head = na) and ring buffer mode (head = int)
// Maintains API compatibility with libBuffers and libRingBuffers
library('libBuffers')

///////////////////////////////////////////////////////////////////////////////
// UNIFIED BUFFER TYPES
///////////////////////////////////////////////////////////////////////////////

// @type BufferFloat - Unified float buffer supporting both array and ring modes
// @field data (array<float>) Data storage array
// @field max_size (int) Maximum buffer capacity
// @field head (int) Ring buffer head position (na = array mode, int = ring mode)
// @field count (int) Total items ever inserted
// @field needs_compaction (bool) Flag indicating array mode needs compaction
// @field _linear (array<float>) Cached linearized array for ring mode (na when invalid)
export type BufferFloat
    array<float> data = na
    int max_size = 20
    int head = na
    int count = 0
    bool needs_compaction = false
    array<float> _linear = na

// @type BufferInt - Unified integer buffer supporting both array and ring modes
// @field data (array<int>) Data storage array
// @field max_size (int) Maximum buffer capacity
// @field head (int) Ring buffer head position (na = array mode, int = ring mode)
// @field count (int) Total items ever inserted
// @field needs_compaction (bool) Flag indicating array mode needs compaction
// @field _linear (array<int>) Cached linearized array for ring mode (na when invalid)
export type BufferInt
    array<int> data = na
    int max_size = 20
    int head = na
    int count = 0
    bool needs_compaction = false
    array<int> _linear = na

// @function getLinearized
// @description Returns a linearized view of buffer data with caching for ring mode
// @param this: BufferFloat - The buffer to linearize
// @returns array<float> - Linear array (reference in array mode, cached in ring mode)
export method getLinearized(BufferFloat this) =>
    if na(this.head)
        // Array mode - return reference to data
        this.data
    else
        // Ring mode - use cache if valid, otherwise compute and cache
        if na(this._linear)
            // Ring mode - concatenate slices to create linear view
            older_section = array.slice(this.data, this.head, this.max_size)
            newer_section = array.slice(this.data, 0, this.head)
            this._linear := array.concat(older_section, newer_section)
        this._linear

// @function getLinearized
// @description Returns a linearized view of buffer data with caching for ring mode
// @param this: BufferInt - The buffer to linearize
// @returns array<int> - Linear array (reference in array mode, cached in ring mode)
export method getLinearized(BufferInt this) =>
    if na(this.head)
        // Array mode - return reference to data
        this.data
    else
        // Ring mode - use cache if valid, otherwise compute and cache
        if na(this._linear)
            // Ring mode - concatenate slices to create linear view
            older_section = array.slice(this.data, this.head, this.max_size)
            newer_section = array.slice(this.data, 0, this.head)
            this._linear := array.concat(older_section, newer_section)
        this._linear

///////////////////////////////////////////////////////////////////////////////
// CORE BUFFER MANAGEMENT - FLOAT
///////////////////////////////////////////////////////////////////////////////

// @function init
// @description Initializes a BufferFloat object with the specified buffer size and ring mode.
// @param this: BufferFloat - The BufferFloat object to initialize.
// @param buffer_size: int - The size of the buffer.
// @param ring_mode: bool - Whether to use ring mode for the buffer.
// @returns BufferFloat - The initialized BufferFloat object.
export method init(BufferFloat this, int buffer_size = 20, bool ring_mode = false) =>
    this.data := array.new<float>(ring_mode ? buffer_size : 0, na)
    this.max_size := buffer_size
    this.head := ring_mode ? 0 : na
    this.count := 0
    this.needs_compaction := false
    this

// @function push
// @description Adds a new value to the buffer, either appending to an array or overwriting in ring mode.
// @param this: BufferFloat - The buffer to which the value is added.
// @param value: float - The value to be added to the buffer.
// @returns BufferFloat - The updated buffer after adding the value.
export method push(BufferFloat this, float value) =>
    if na(this.head)
        // Array mode: append and check size
        array.push(this.data, value)
        if array.size(this.data) > this.max_size
            this.needs_compaction := true
    else
        // Ring mode: overwrite at head position
        array.set(this.data, this.head, value)
        this.head := (this.head + 1) % this.max_size
        this._linear := na  // Invalidate cache

    this.count := this.count + 1
    this

// @function get
// @description Retrieves the value at a specified index from the buffer.
// @param this: BufferFloat - The buffer from which to retrieve the value.
// @param index: int - The index of the value to retrieve.
// @returns float - The value at the specified index, or na if the index is out of bounds.
export method get(BufferFloat this, int index) =>
    if na(this.head)
        // Array mode: direct access from end
        size = array.size(this.data)
        if index < 0 or index >= size
            na
        else
            array.get(this.data, size - 1 - index)
    else
        // Ring mode: circular access
        if index < 0 or index >= this.max_size or index >= this.count
            na
        else
            actual_pos = (this.head - 1 - index + this.max_size) % this.max_size
            array.get(this.data, actual_pos)

// @function size
// @description Returns the size of the buffer, either the count of elements or the maximum size, whichever is smaller.
// @param this: BufferFloat - The buffer for which to calculate the size.
// @returns int - The size of the buffer.
export method size(BufferFloat this) =>
    if na(this.head)
        array.size(this.data)
    else
        math.min(this.count, this.max_size)

// @function clear
// @description Clears the contents of a BufferFloat object, resetting it to its initial state.
// @param this: BufferFloat - The BufferFloat object to be cleared.
// @returns BufferFloat - The cleared BufferFloat object.
export method clear(BufferFloat this) =>
    if na(this.head)
        array.clear(this.data)
    else
        array.fill(this.data, na)
        this.head := 0
        this._linear := na  // Invalidate cache

    this.count := 0
    this.needs_compaction := false
    this

// @function valid_count
// @description Returns the count of non-NaN values in a BufferFloat.
// @param this: BufferFloat - The buffer to count valid values from.
// @returns int - The count of non-NaN values in the buffer.
export method valid_count(BufferFloat this) =>
    count = 0
    size = this.size()
    for i = 0 to size - 1
        if not na(this.get(i))
            count += 1
    count

// @function is_empty
// @description Returns true if the buffer has no valid elements.
// @param this: BufferFloat - The buffer to check for emptiness.
// @returns bool - True if the buffer is empty, false otherwise.
export method is_empty(BufferFloat this) =>
    this.valid_count() == 0

// @function is_full
// @description Returns true if the buffer is completely filled with valid data.
// @param this: BufferFloat - The buffer to check for fullness.
// @returns bool - True if the buffer is full, false otherwise.
export method is_full(BufferFloat this) =>
    if na(this.head)
        array.size(this.data) >= this.max_size and this.valid_count() == this.max_size
    else
        this.valid_count() == this.max_size

// @function max_capacity
// @description Returns the maximum capacity of the buffer.
// @param this: BufferFloat - The buffer from which to retrieve the maximum capacity.
// @returns float - The maximum capacity of the buffer.
export method max_capacity(BufferFloat this) =>
    this.max_size

// @function for_each_valid
// @description Iterates over a BufferFloat from a given start index, collects non-na values into an array, and returns the array.
// @param this: BufferFloat - The BufferFloat to iterate over.
// @param start_index: int - The index to start iterating from (default is 0).
// @returns array<float> - An array containing the non-na values from the BufferFloat.
export method for_each_valid(BufferFloat this, int start_index = 0) =>
    result = array.new<float>()
    size = this.size()
    for i = start_index to size - 1
        value = this.get(i)
        if not na(value)
            array.push(result, value)
    result

// @function get_valid_indices
// @description Returns an array of indices where the values in the given BufferFloat are not NaN.
// @param this: BufferFloat - The input buffer to check for valid indices.
// @returns array<int> - An array of integer indices where the values are not NaN.
export method get_valid_indices(BufferFloat this) =>
    result = array.new<int>()
    size = this.size()
    for i = 0 to size - 1
        if not na(this.get(i))
            array.push(result, i)
    result

// @function compact
// @description Compacts the buffer by removing NA values and adjusting the head position if necessary.
// @param this: BufferFloat - The buffer to compact.
// @returns int - The number of NA values removed from the buffer.
export method compact(BufferFloat this) =>
    if na(this.head)
        // Array mode: remove na values
        original_size = array.size(this.data)
        valid_values = this.for_each_valid()

        array.clear(this.data)
        this.data := valid_values

        this.needs_compaction := false
        original_size - array.size(this.data)
    else
        // Ring mode: cannot compact without breaking structure
        0

///////////////////////////////////////////////////////////////////////////////
// STATISTICAL METHODS - FLOAT (OPTIMIZED)
///////////////////////////////////////////////////////////////////////////////

// @function max
// @description Returns the maximum value in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @returns float - The maximum value, or na if the buffer is empty.
export method max(BufferFloat this) =>
    array.max(this.getLinearized())

// @function min
// @description Returns the minimum value in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @returns float - The minimum value, or na if the buffer is empty.
export method min(BufferFloat this) =>
    array.min(this.getLinearized())

// @function sum
// @description Returns the sum of all values in the buffer.
// @param this: BufferFloat - The buffer to sum.
// @returns float - The sum of all values.
export method sum(BufferFloat this) =>
    array.sum(this.getLinearized())

// @function avg
// @description Returns the average (mean) of all values in the buffer.
// @param this: BufferFloat - The buffer to average.
// @returns float - The average value, or na if the buffer is empty.
export method avg(BufferFloat this) =>
    array.avg(this.getLinearized())

// @function stdev
// @description Returns the standard deviation of values in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @param biased: bool - Whether to use biased (population) or unbiased (sample) estimate.
// @returns float - The standard deviation, or na if insufficient data.
export method stdev(BufferFloat this, bool biased = true) =>
    array.stdev(this.getLinearized(), biased)

// @function variance
// @description Returns the variance of values in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @param biased: bool - Whether to use biased (population) or unbiased (sample) estimate.
// @returns float - The variance, or na if insufficient data.
export method variance(BufferFloat this, bool biased = true) =>
    array.variance(this.getLinearized(), biased)

// @function median
// @description Returns the median value in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @returns float - The median value, or na if the buffer is empty.
export method median(BufferFloat this) =>
    array.median(this.getLinearized())

// @function mode
// @description Returns the most frequently occurring value in the buffer.
// @param this: BufferFloat - The buffer to analyze.
// @returns float - The mode value, or na if the buffer is empty.
export method mode(BufferFloat this) =>
    array.mode(this.getLinearized())

// @function standardize
// @description Returns an array of standardized (z-score) values from the buffer.
// @param this: BufferFloat - The buffer to standardize.
// @returns array<float> - Array of z-scores.
export method standardize(BufferFloat this) =>
    array.standardize(this.getLinearized())

// @function percentile
// @description Returns the value at the specified percentile using linear interpolation.
// @param this: BufferFloat - The buffer to analyze.
// @param percentage: float - The percentile to find (0-100).
// @returns float - The value at the specified percentile.
export method percentile(BufferFloat this, float percentage) =>
    array.percentile_linear_interpolation(this.getLinearized(), percentage)

///////////////////////////////////////////////////////////////////////////////
// ADVANCED STATISTICAL METHODS - FLOAT (OPTIMIZED)
///////////////////////////////////////////////////////////////////////////////

// @function covariance
// @description Calculates the covariance between two BufferFloat objects.
// @param this: BufferFloat - The first buffer.
// @param other: BufferFloat - The second buffer.
// @param biased: bool - Whether to use biased (population) or unbiased (sample) estimate.
// @returns float - The covariance between the two buffers.
export method covariance(BufferFloat this, BufferFloat other, bool biased = true) =>
    linear_this = this.getLinearized()
    linear_other = other.getLinearized()

    min_size = math.min(array.size(linear_this), array.size(linear_other))

    if min_size < 2
        na
    else
        slice_this = array.slice(linear_this, 0, min_size)
        slice_other = array.slice(linear_other, 0, min_size)
        array.covariance(slice_this, slice_other, biased)

// @function correlation
// @description Calculates the Pearson correlation coefficient between two BufferFloat objects.
// @param this: BufferFloat - The first buffer.
// @param other: BufferFloat - The second buffer.
// @returns float - The correlation coefficient (-1 to 1), or na if insufficient data.
export method correlation(BufferFloat this, BufferFloat other) =>
    linear_this = this.getLinearized()
    linear_other = other.getLinearized()

    min_size = math.min(array.size(linear_this), array.size(linear_other))

    if min_size < 2
        na
    else
        slice_this = array.slice(linear_this, 0, min_size)
        slice_other = array.slice(linear_other, 0, min_size)

        cov = array.covariance(slice_this, slice_other, true)
        std_this = array.stdev(slice_this, true)
        std_other = array.stdev(slice_other, true)

        if std_this > 0 and std_other > 0
            cov / (std_this * std_other)
        else
            na

// @function linreg
// @description Calculates linear regression slope and intercept for the buffer data.
// @param this: BufferFloat - The buffer containing y-values.
// @returns array<float> - [slope, intercept] or [na, na] if insufficient data.
export method linreg(BufferFloat this) =>
    linear = this.getLinearized()
    n = array.size(linear)

    if n < 2
        [na, na]
    else
        // Use built-in avg for mean calculation
        mean_y = array.avg(linear)
        mean_x = (n - 1) / 2.0  // Arithmetic series mean

        sum_xy = 0.0
        sum_x_sq = 0.0

        for i = 0 to n - 1
            x_dev = i - mean_x
            sum_xy += x_dev * array.get(linear, i)
            sum_x_sq += x_dev * x_dev

        if sum_x_sq == 0
            [na, na]
        else
            slope = sum_xy / sum_x_sq
            intercept = mean_y - slope * mean_x
            [slope, intercept]

// @function predict
// @description Predicts the value at a future position using linear regression.
// @param this: BufferFloat - The buffer to analyze.
// @param position: int - The position to predict (default 1 = next value).
// @returns float - The predicted value, or na if insufficient data.
export method predict(BufferFloat this, int position = 1) =>
    [slope, intercept] = this.linreg()
    if na(slope) or na(intercept)
        na
    else
        n = this.size()
        predicted_x = n + position - 1
        slope * predicted_x + intercept

///////////////////////////////////////////////////////////////////////////////
// CORE BUFFER MANAGEMENT - INT
///////////////////////////////////////////////////////////////////////////////

// @function init
// @description Initializes a BufferInt object with the specified buffer size and ring mode.
// @param this: BufferInt - The BufferInt object to initialize.
// @param buffer_size: int - The size of the buffer.
// @param ring_mode: bool - Whether to use ring mode for the buffer.
// @returns BufferInt - The initialized BufferInt object.
export method init(BufferInt this, int buffer_size = 20, bool ring_mode = false) =>
    this.data := array.new<int>(ring_mode ? buffer_size : 0, na)
    this.max_size := buffer_size
    this.head := ring_mode ? 0 : na
    this.count := 0
    this.needs_compaction := false
    this

// @function push
// @description Adds a new value to the buffer, either appending to an array or overwriting in ring mode.
// @param this: BufferInt - The buffer to which the value is added.
// @param value: int - The value to be added to the buffer.
// @returns BufferInt - The updated buffer after adding the value.
export method push(BufferInt this, int value) =>
    if na(this.head)
        // Array mode: append and check size
        array.push(this.data, value)
        if array.size(this.data) > this.max_size
            this.needs_compaction := true
    else
        // Ring mode: overwrite at head position
        array.set(this.data, this.head, value)
        this.head := (this.head + 1) % this.max_size
        this._linear := na  // Invalidate cache

    this.count := this.count + 1
    this

// @function get
// @description Retrieves the value at a specified index from the buffer.
// @param this: BufferInt - The buffer from which to retrieve the value.
// @param index: int - The index of the value to retrieve.
// @returns int - The value at the specified index, or na if the index is out of bounds.
export method get(BufferInt this, int index) =>
    if na(this.head)
        // Array mode: direct access from end
        size = array.size(this.data)
        if index < 0 or index >= size
            na
        else
            array.get(this.data, size - 1 - index)
    else
        // Ring mode: circular access
        if index < 0 or index >= this.max_size or index >= this.count
            na
        else
            actual_pos = (this.head - 1 - index + this.max_size) % this.max_size
            array.get(this.data, actual_pos)

// @function size
// @description Returns the size of the buffer, either the count of elements or the maximum size, whichever is smaller.
// @param this: BufferInt - The buffer for which to calculate the size.
// @returns int - The size of the buffer.
export method size(BufferInt this) =>
    if na(this.head)
        array.size(this.data)
    else
        math.min(this.count, this.max_size)

// @function clear
// @description Clears the contents of a BufferInt object, resetting it to its initial state.
// @param this: BufferInt - The BufferInt object to be cleared.
// @returns BufferInt - The cleared BufferInt object.
export method clear(BufferInt this) =>
    if na(this.head)
        array.clear(this.data)
    else
        array.fill(this.data, na)
        this.head := 0
        this._linear := na  // Invalidate cache

    this.count := 0
    this.needs_compaction := false
    this

// @function valid_count
// @description Returns the count of non-NaN values in a BufferInt.
// @param this: BufferInt - The buffer to count valid values from.
// @returns int - The count of non-NaN values in the buffer.
export method valid_count(BufferInt this) =>
    count = 0
    size = this.size()
    for i = 0 to size - 1
        if not na(this.get(i))
            count += 1
    count

// @function is_empty
// @description Returns true if the buffer has no valid elements.
// @param this: BufferInt - The buffer to check for emptiness.
// @returns bool - True if the buffer is empty, false otherwise.
export method is_empty(BufferInt this) =>
    this.valid_count() == 0

// @function is_full
// @description Returns true if the buffer is completely filled with valid data.
// @param this: BufferInt - The buffer to check for fullness.
// @returns bool - True if the buffer is full, false otherwise.
export method is_full(BufferInt this) =>
    if na(this.head)
        array.size(this.data) >= this.max_size and this.valid_count() == this.max_size
    else
        this.valid_count() == this.max_size

// @function max_capacity
// @description Returns the maximum capacity of the buffer.
// @param this: BufferInt - The buffer from which to retrieve the maximum capacity.
// @returns int - The maximum capacity of the buffer.
export method max_capacity(BufferInt this) =>
    this.max_size

// @function for_each_valid
// @description Iterates over a BufferInt from a given start index, collects non-na values into an array, and returns the array.
// @param this: BufferInt - The BufferInt to iterate over.
// @param start_index: int - The index to start iterating from (default is 0).
// @returns array<int> - An array containing the non-na values from the BufferInt.
export method for_each_valid(BufferInt this, int start_index = 0) =>
    result = array.new<int>()
    size = this.size()
    for i = start_index to size - 1
        value = this.get(i)
        if not na(value)
            array.push(result, value)
    result

// @function get_valid_indices
// @description Returns an array of indices where the values in the given BufferInt are not NaN.
// @param this: BufferInt - The input buffer to check for valid indices.
// @returns array<int> - An array of integer indices where the values are not NaN.
export method get_valid_indices(BufferInt this) =>
    result = array.new<int>()
    size = this.size()
    for i = 0 to size - 1
        if not na(this.get(i))
            array.push(result, i)
    result

// @function compact
// @description Compacts the buffer by removing NA values and adjusting the head position if necessary.
// @param this: BufferInt - The buffer to compact.
// @returns int - The number of NA values removed from the buffer.
export method compact(BufferInt this) =>
    if na(this.head)
        // Array mode: remove na values
        original_size = array.size(this.data)
        valid_values = this.for_each_valid()

        array.clear(this.data)
        this.data := valid_values

        this.needs_compaction := false
        original_size - array.size(this.data)
    else
        // Ring mode: cannot compact without breaking structure
        0

///////////////////////////////////////////////////////////////////////////////
// STATISTICAL METHODS - INT (OPTIMIZED)
///////////////////////////////////////////////////////////////////////////////

// @function max
// @description Returns the maximum value in the buffer.
// @param this: BufferInt - The buffer to analyze.
// @returns int - The maximum value, or na if the buffer is empty.
export method max(BufferInt this) =>
    array.max(this.getLinearized())

// @function min
// @description Returns the minimum value in the buffer.
// @param this: BufferInt - The buffer to analyze.
// @returns int - The minimum value, or na if the buffer is empty.
export method min(BufferInt this) =>
    array.min(this.getLinearized())

// @function sum
// @description Returns the sum of all values in the buffer.
// @param this: BufferInt - The buffer to sum.
// @returns int - The sum of all values.
export method sum(BufferInt this) =>
    array.sum(this.getLinearized())

// @function avg
// @description Returns the average (mean) of all values in the buffer.
// @param this: BufferInt - The buffer to average.
// @returns float - The average value, or na if the buffer is empty.
export method avg(BufferInt this) =>
    array.avg(this.getLinearized())

// @function median
// @description Returns the median value in the buffer.
// @param this: BufferInt - The buffer to analyze.
// @returns int - The median value, or na if the buffer is empty.
export method median(BufferInt this) =>
    array.median(this.getLinearized())

// @function mode
// @description Returns the most frequently occurring value in the buffer.
// @param this: BufferInt - The buffer to analyze.
// @returns int - The mode value, or na if the buffer is empty.
export method mode(BufferInt this) =>
    array.mode(this.getLinearized())

///////////////////////////////////////////////////////////////////////////////
// STANDALONE ARRAY FUNCTIONS - FLOAT (LEGACY COMPATIBILITY)
///////////////////////////////////////////////////////////////////////////////

// @function valid_count
// @description Returns the count of non-null values in an array of floats.
// @param data_array: array<float> - The array to count valid values from.
// @returns int - The count of non-null values in the array.
export valid_count(array<float> data_array) =>
    if na(data_array)
        0
    else
        count = 0
        size = array.size(data_array)
        for i = 0 to size - 1
            if not na(array.get(data_array, i))
                count += 1
        count

// @function for_each_valid
// @description Iterates over an array and returns a new array containing only non-null values.
// @param data_array: array<float> - The array to iterate over.
// @param start_index: int - The index to start iterating from (default is 0).
// @returns array<float> - An array containing the non-null values.
export for_each_valid(array<float> data_array, int start_index = 0) =>
    result = array.new<float>()
    if not na(data_array)
        size = array.size(data_array)
        for i = start_index to size - 1
            value = array.get(data_array, i)
            if not na(value)
                array.push(result, value)
    result

// @function get_valid_indices
// @description Returns an array of indices where the values in the given array are not NaN.
// @param data_array: array<float> - The input array to check for valid indices.
// @returns array<int> - An array of integer indices where the values are not NaN.
export get_valid_indices(array<float> data_array) =>
    result = array.new<int>()
    if not na(data_array)
        size = array.size(data_array)
        for i = 0 to size - 1
            if not na(array.get(data_array, i))
                array.push(result, i)
    result

// @function covariance
// @description Calculates the covariance between two arrays of floats.
// @param array1: array<float> - The first array.
// @param array2: array<float> - The second array.
// @param biased: bool - Whether to use biased (population) or unbiased (sample) estimate.
// @returns float - The covariance between the two arrays.
export covariance(array<float> array1, array<float> array2, bool biased = true) =>
    if na(array1) or na(array2)
        na
    else
        min_size = math.min(array.size(array1), array.size(array2))
        if min_size < 2
            na
        else
            slice1 = array.slice(array1, 0, min_size)
            slice2 = array.slice(array2, 0, min_size)
            array.covariance(slice1, slice2, biased)

// @function correlation
// @description Calculates the Pearson correlation coefficient between two arrays of floats.
// @param array1: array<float> - The first array.
// @param array2: array<float> - The second array.
// @returns float - The correlation coefficient (-1 to 1), or na if insufficient data.
export correlation(array<float> array1, array<float> array2) =>
    if na(array1) or na(array2)
        na
    else
        min_size = math.min(array.size(array1), array.size(array2))
        if min_size < 2
            na
        else
            slice1 = array.slice(array1, 0, min_size)
            slice2 = array.slice(array2, 0, min_size)

            cov = array.covariance(slice1, slice2, true)
            std1 = array.stdev(slice1, true)
            std2 = array.stdev(slice2, true)

            if std1 > 0 and std2 > 0
                cov / (std1 * std2)
            else
                na

// @function linreg
// @description Calculates the linear regression slope and intercept for a given array of float values.
// @param data_array: array<float> - The array of float values to perform linear regression on.
// @returns array<float> - An array containing the slope and intercept of the linear regression.
export linreg(array<float> data_array) =>
    if na(data_array) or array.size(data_array) < 2
        [na, na]
    else
        valid_values = for_each_valid(data_array)
        n = array.size(valid_values)

        if n < 2
            [na, na]
        else
            mean_y = array.avg(valid_values)
            mean_x = (n - 1) / 2.0

            sum_xy = 0.0
            sum_x_sq = 0.0

            for i = 0 to n - 1
                x_dev = i - mean_x
                sum_xy += x_dev * array.get(valid_values, i)
                sum_x_sq += x_dev * x_dev

            if sum_x_sq == 0
                [na, na]
            else
                slope = sum_xy / sum_x_sq
                intercept = mean_y - slope * mean_x
                [slope, intercept]

// @function predict
// @description Predicts the value at a given position using linear regression on the provided data array.
// @param data_array: array<float> - The array of data points to perform linear regression on.
// @param position: int - The position at which to predict the value, default is 1.
// @returns float - The predicted value at the specified position.
export predict(array<float> data_array, int position = 1) =>
    [slope, intercept] = linreg(data_array)
    if na(slope) or na(intercept)
        na
    else
        valid_count_val = valid_count(data_array)
        predicted_x = valid_count_val + position - 1
        slope * predicted_x + intercept

// @function mark_for_removal
// @description Marks the specified index in the data array for removal by setting it to NA.
// @param data_array: array<float> - The array of floating-point numbers to modify.
// @param index: int - The index in the array to mark for removal.
// @returns bool - True if the index was successfully marked, false otherwise.
export mark_for_removal(array<float> data_array, int index) =>
    if na(data_array) or index < 0 or index >= array.size(data_array)
        false
    else
        array.set(data_array, index, na)
        true

// @function compact
// @description Removes all NaN values from an array and returns the number of removed elements.
// @param data_array: array<float> - The array from which NaN values will be removed.
// @returns int - The number of NaN values removed from the array.
export compact(array<float> data_array) =>
    if na(data_array)
        0
    else
        original_size = array.size(data_array)
        valid_values = for_each_valid(data_array)
        valid_size = array.size(valid_values)

        array.clear(data_array)
        for i = 0 to valid_size - 1
            array.push(data_array, array.get(valid_values, i))

        original_size - valid_size

// @function remove_value
// @description Removes all occurrences of a specified value from an array and returns true if any values were removed.
// @param data_array: array<float> - The array from which values will be removed.
// @param value: float - The value to be removed from the array.
// @returns bool - True if any values were removed, false otherwise.
export remove_value(array<float> data_array, float value) =>
    if na(data_array)
        false
    else
        removed_any = false

        // Use indexof in while loop instead of for loop
        while true
            idx = array.indexof(data_array, value)
            if idx == -1
                break
            array.set(data_array, idx, na)
            removed_any := true

        if removed_any
            compact(data_array)

        removed_any

// @function last
// @description Returns the last non-null value from an array of floats.
// @param data_array: array<float> - The array from which to retrieve the last non-null value.
// @returns float - The last non-null value in the array, or na if the array is empty or contains only nulls.
export last(array<float> data_array) =>
    float retval = na
    if na(data_array) or array.size(data_array) == 0
        retval
    else
        size = array.size(data_array)
        for i = size - 1 to 0
            value = array.get(data_array, i)
            if not na(value)
                retval := value
                break
    retval

// @function push_and_limit
// @description Adds a value to an array and ensures its size does not exceed a specified maximum.
// @param data_array: array<float> - The array to which the value will be added.
// @param value: float - The value to be added to the array.
// @param max_size: int - The maximum size the array should maintain.
// @returns array<float> - The modified array with the new value added and size limited.
export push_and_limit(array<float> data_array, float value, int max_size) =>
    if not na(data_array) and max_size > 0
        array.push(data_array, value)

        while array.size(data_array) > max_size
            array.shift(data_array)

        data_array

///////////////////////////////////////////////////////////////////////////////
// INTEGER ARRAY LEGACY FUNCTIONS
///////////////////////////////////////////////////////////////////////////////

// @function valid_count_int
// @description Returns the count of non-null (valid) integers in the given array.
// @param data_array: array<int> - The array of integers to check for valid (non-null) values.
// @returns int - The count of non-null integers in the array.
export valid_count_int(array<int> data_array) =>
    if na(data_array)
        0
    else
        count = 0
        size = array.size(data_array)
        for i = 0 to size - 1
            if not na(array.get(data_array, i))
                count += 1
        count

// @function for_each_valid_int
// @description Iterates over an array of integers starting from a specified index, pushing non-null values to a new array.
// @param data_array: array<int> - The array of integers to iterate over.
// @param start_index: int - The index to start iterating from (default is 0).
// @returns array<int> - An array containing the non-null values from the original array, starting from the specified index.
export for_each_valid_int(array<int> data_array, int start_index = 0) =>
    result = array.new<int>()
    if not na(data_array)
        size = array.size(data_array)
        for i = start_index to size - 1
            value = array.get(data_array, i)
            if not na(value)
                array.push(result, value)
    result

// @function get_valid_indices_int
// @description Returns an array of indices where the elements in the input array are not NaN.
// @param data_array: array<int> - The input array of integers.
// @returns array<int> - An array of indices where the elements are not NaN.
export get_valid_indices_int(array<int> data_array) =>
    result = array.new<int>()
    if not na(data_array)
        size = array.size(data_array)
        for i = 0 to size - 1
            if not na(array.get(data_array, i))
                array.push(result, i)
    result

// @function push_and_limit
// @description Adds a value to an integer array and ensures the array does not exceed a specified maximum size.
// @param data_array: array<int> - The integer array to which the value will be added.
// @param value: int - The integer value to be added to the array.
// @param max_size: int - The maximum size the array should maintain.
// @returns array<int> - The updated integer array, not exceeding the specified maximum size.
export push_and_limit(array<int> data_array, int value, int max_size) =>
    if not na(data_array) and max_size > 0
        array.push(data_array, value)

        while array.size(data_array) > max_size
            array.shift(data_array)

    data_array
