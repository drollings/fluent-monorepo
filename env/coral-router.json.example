      "retry_count": 1,
      "retry_base_interval_s": 5,
      "total_timeout_ms": 300000,
      "idle_timeout_ms": 30000,
      "params": {
        "num_ctx": 32768,
        "repeat_penalty": 1.03,
        "temperature": 0.7
      },
