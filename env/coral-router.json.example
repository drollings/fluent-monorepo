      "weights": "/app/ai/models/gguf/davidau/qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp-gguf/latest.gguf",
      "template": "/app/ai/models/gguf/davidau/qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp-gguf/template.txt",
      "intelligence": 6,
