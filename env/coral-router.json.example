{
  "pipelines": {
    "default": {
      "deterministic_prefilter": true,
      "classifier": true,
      "coherence_threshold": 0.2
    }
  },
  "models": {
    "default": {
      "intelligence": 1,
      "cost_input": 1e-06,
      "cost_output": 6e-06,
      "cost_cached_read": 4e-07,
      "embedding": "/app/ai/models/gguf/google/embeddinggemma-300m/latest.gguf",
      "tok_s": 20,
      "total_timeout_ms": 30000,
      "idle_timeout_ms": 10000,
      "stream": true,
      "filter_thinking": true,
      "retry_count": 0,
      "retry_base_interval_s": 2,
      "params": {
        "num_ctx": 8192,
        "max_ctx": 262144,
        "batch_size": 2048,
        "ubatch_size": 512,
        "cache_type_k": "q4_0",
        "cache_type_v": "q4_0",
        "flash_attn": "on",
        "n_gpu_layers": 999,
        "n_cpu_moe": 0,
        "sleep_idle_seconds": 60,
        "stream": true,
        "filter_thinking": true,
        "temperature": 0.1
      }
    },
    "lfm2.5-350m": {
      "name": "liquidai/lfm2.5-350m",
