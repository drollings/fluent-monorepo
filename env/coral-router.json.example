  "roles": {
    "quick": {
      "context": {
        "num_ctx": 8192,
        "pinned": true
      },
      "concurrency": {
        "max_parallel": 2
      },
      "params": {
        "temperature": 0.6,
        "repeat_penalty": 1.0
      },
      "instances": {
        "quick": {
          "num_ctx": 8192,
          "pinned": true
        }
      },
      "models": {
        "lfm2.5-2.6b": {},
        "qwen3.5-9b": {},
        "qwen3.8-27b": {}
      }
    },
    "ledger": {
      "context": {
        "num_ctx": 128000
      },
      "params": {
        "sleep_idle_seconds": 7200,
        "temperature": 0.1,
        "repeat_penalty": 1.01
      },
      "models": {
        "qwen3.5-9b": {}
      }
    },
    "json": {
      "context": {
        "num_ctx": 16384,
        "pinned": true
      },
      "params": {
        "temperature": 0.1,
        "repeat_penalty": 1.0
      }
    },
    "scratch": {
      "context": {
        "num_ctx": 128000
      },
      "concurrency": {
        "max_parallel": 1
      },
      "params": {
        "sleep_idle_seconds": 60,
        "temperature": 0.7,
        "top_p": 0.95,
        "repeat_penalty": 1.03
      },
      "instances": {
        "scratch": {
          "num_ctx": 128000
        }
      },
      "models": {
        "lfm2.5-2.6b": {},
        "qwen3.5-9b": {},
        "gemma4-12b": {}
      }
    },
    "reasoning": {
      "context": {
        "num_ctx": 128000
      },
      "concurrency": {
        "max_parallel": 1
      },
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "reasoning_effort": "high",
        "reasoning_budget_tokens": 4096,
        "preserve_thinking": true,
        "sleep_idle_seconds": 300,
        "temperature": 0.7,
        "top_p": 0.95,
        "repeat_penalty": 1.03
      },
      "instances": {
        "reasoning": {
          "num_ctx": 128000
        }
      },
      "models": {
        "lfm2.5-2.6b": {},
        "qwen3.5-9b": {},
        "qwen3.8-27b": {}
      }
    }
  },
  "classification": {
    "root": {
      "type": "classifier",
      "description": "Coral request router",
      "model": "last",
      "coherence_threshold": 0.1,
      "safety_threshold": 0.2,
      "children": [
        {
          "key": "local",
          "description": "General Q&A, simple questions, chitchat, research queries, brainstorming, and help formulating prompts. Answered directly by the classifier when simple.",
          "node": {
            "type": "terminal",
            "route": "local",
            "role": "quick",
            "group": "default",
            "description": "General Q&A",
            "always_route": false
          }
        },
        {
          "key": "code",
          "description": "Programming, software development, Linux, bash, Python, Rust, dev-ops, debugging, and technical implementation - write, debug, or explain code.",
          "node": {
            "type": "terminal",
            "route": "code",
            "role": "reasoning",
            "group": "code",
            "description": "Code",
            "always_route": true
          }
        },
        {
          "key": "summarize",
          "description": "Summarize or condense text - an article, report, email thread, meeting notes, or other content, into a shorter form.",
          "node": {
            "type": "terminal",
            "route": "summarize",
            "role": "scratch",
            "group": "summarize",
            "description": "Summarize",
            "always_route": false
          }
        },
        {
          "key": "explore",
          "description": "Search, navigate, look up, or pull a value - search the web, open a page, look up an API, query data storage or a knowledge graph, or extract a specific value (a date, amount, email, or identifier) from text.",
          "node": {
            "type": "terminal",
            "route": "explore",
            "role": "scratch",
            "group": "explore",
            "description": "Explore",
            "always_route": true
          }
        },
        {
          "key": "reasoning",
          "description": "A deep answer - translate between languages, analyze or reason about a topic, identify named entities in text, or explain a concept from the sciences, mathematics, medicine, or law.",
          "node": {
            "type": "terminal",
            "route": "reasoning",
            "role": "reasoning",
            "group": "reason",
            "description": "Explain",
            "always_route": true
          }
        },
        {
          "key": "translate",
          "description": "Translate a text from one language into another.",
          "node": {
            "type": "terminal",
            "route": "translate",
            "role": "reasoning",
            "group": "translate",
            "description": "Translate",
            "always_route": false
          }
        },
        {
          "key": "prose",
          "description": "Write a story, novel, poem, essay, screenplay, or letter - any substantial creative writing.",
          "node": {
            "type": "terminal",
            "route": "prose",
            "role": "scratch",
            "group": "prose",
            "description": "Prose",
            "always_route": true
          }
        }
      ]
    }
  },
  "model_groups": {
    "default": [
      "last",
      "lfm2.5-2.6b",
      "qwen3.5-9b"
    ],
    "code": [
      "qwen3.5-9b",
      "qwen3.8-27b"
    ],
    "reason": [
      "qwen3.5-9b",
      "qwen3.8-27b",
      "last"
    ],
    "summarize": [
      "last",
      "qwen3.5-9b"
    ],
    "explore": [
      "lfm2.5-2.6b",
      "qwen3.5-9b",
      "last"
    ],
    "translate": [
      "lfm2.5-2.6b",
      "qwen3.8-27b",
      "last"
    ],
    "prose": [
      "lfm2.5-2.6b",
      "gemma4-12b",
      "last"
    ]
  },
  "default_route": "local",
  "charts": {
    "dir": "env/workflows/charts",
    "index_path": "data/workflow_library.sqlite",
    "selector_group": "default",
    "max_candidates": 6,
    "min_score": 0.6,
    "entity_context": true
  },
  "post_process": {
    "workflow_extraction": false
  },
  "ledger": {
    "path": "data/ledger.sqlite",
    "group": "code"
  },
  "session": {
    "root": "data/sessions"
  },
  "gguf_dir": "/app/ai/models/gguf",
  "server": {
    "bind_addr": "127.0.0.1:8079",
    "max_payload": 1048576
  },
  "sidecar": {
    "poll_interval_s": 5,
    "vram_low_watermark_bytes": 2048000000,
    "evict_batch": 1,
    "vram_total_bytes": null,
    "minimum_remaining_vram": 1024000000,
    "slot_save_path": "/tmp/_coral-router/slots",
    "resume_ttl_s": 3600,
    "snapshot_ttl_s": 604800,
    "snapshot_budget_bytes": 20480000000,
    "server_state_path": "data/server_state.json",
    "api_key_env": null
  },
  "logging": {
    "log_dir": "logs",
    "max_file_size_mb": 10,
    "max_age_days": 3,
    "max_files": 4,
    "json_format": false,
    "console_output": true,
    "audit_log": {
      "log_dir": "logs/audit",
      "max_file_size_mb": 50,
      "max_age_days": 90,
      "max_files": 20,
      "json_format": true,
      "console_output": false
    }
  }
}
